<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/webp" href="/img/principal-gradiente.webp" />
  <meta name="description" content="Relatório de crescimento de usuários — Ápice." />
  <title>Ápice — Admin · <%= categoria.titulo %></title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/design-system.css" />
  <link rel="stylesheet" href="/css/header.css" />
  <link rel="stylesheet" href="/css/admin-dashboard.css" />
  <link rel="stylesheet" href="/css/admin-vagas.css" />
  <link rel="stylesheet" href="/css/admin-relatorios.css" />
  <link rel="stylesheet" href="/css/admin-crescimento.css" />
</head>
<body>

  <%- include('partials/header-admin', { currentPage: 'admin-relatorios' }) %>

<main class="adm-main" id="main-content">
  <div class="adc-wrap">

    <a href="/admin/relatorios" class="adr-back">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      Voltar
    </a>

    <header class="adr-head">
      <h1 class="adr-title"><%= categoria.titulo %></h1>
      <p class="adr-sub"><%= categoria.descricao %></p>
    </header>

    <section class="adm-loading" id="loading" role="status" aria-live="polite">
      <span class="adm-spinner" aria-hidden="true"></span>
      <p>Carregando relatório...</p>
    </section>

    <div id="content" hidden>

      <%# ── Indicadores ── %>
      <section aria-labelledby="h-kpis">
        <h2 class="visually-hidden" id="h-kpis">Indicadores</h2>
        <ul class="adc-kpis">
          <li class="adc-card">
            <p class="adc-kpi-title">Total de desenvolvedores ativos</p>
            <p class="adc-kpi-row"><strong class="adc-kpi-value" id="k-devs"></strong><span class="adc-badge" id="k-devs-badge"></span></p>
            <span class="adc-split" aria-hidden="true"><span id="k-devs-bar"></span></span>
            <p class="adc-kpi-sub" id="k-devs-sub"></p>
          </li>
          <li class="adc-card">
            <p class="adc-kpi-title">Total de empresas ativas</p>
            <p class="adc-kpi-row"><strong class="adc-kpi-value" id="k-emp"></strong><span class="adc-badge" id="k-emp-badge"></span></p>
            <span class="adc-split" aria-hidden="true"><span id="k-emp-bar"></span></span>
            <p class="adc-kpi-sub" id="k-emp-sub"></p>
          </li>
          <li class="adc-card">
            <p class="adc-kpi-title">Taxa de conversão de FREE para PRO</p>
            <p class="adc-kpi-row"><strong class="adc-kpi-value" id="k-conv"></strong><span class="adc-badge" id="k-conv-badge"></span></p>
            <p class="adc-kpi-sub">Contas PRO sobre o total de contas ativas</p>
          </li>
          <li class="adc-card">
            <p class="adc-kpi-title">Proporção Dev/Empresa</p>
            <p class="adc-kpi-row"><strong class="adc-kpi-value" id="k-ratio"></strong></p>
            <p class="adc-kpi-sub">Desenvolvedores para cada empresa</p>
          </li>
        </ul>
      </section>

      <%# ── Aquisição e evolução ── %>
      <section class="adc-section" aria-labelledby="h-evo" aria-busy="false" id="evo">
        <div class="adc-evo-head">
          <h2 class="adc-h2" id="h-evo">Aquisição e evolução</h2>
          <fieldset class="adv-group adc-seg" id="seg" aria-label="Período dos gráficos">
            <button type="button" class="adv-chip" data-p="7"      aria-pressed="false">7 dias</button>
            <button type="button" class="adv-chip" data-p="30"     aria-pressed="false">30 dias</button>
            <button type="button" class="adv-chip" data-p="90"     aria-pressed="true">90 dias</button>
            <button type="button" class="adv-chip" data-p="custom" aria-pressed="false">Personalizado</button>
          </fieldset>
        </div>

        <form class="adc-range" id="range-form" hidden novalidate>
          <div class="adv-field"><label for="r-from">De</label><input type="date" id="r-from" required /></div>
          <div class="adv-field"><label for="r-to">Até</label><input type="date" id="r-to" required /></div>
          <button type="submit" class="adv-btn adv-btn--primary">Aplicar</button>
          <p class="adv-form-error" id="range-error" role="alert"></p>
        </form>

        <figure class="adc-card adc-chart">
          <figcaption class="adc-chart-head">
            <h3 class="adc-h3">Crescimento de novos cadastros</h3>
            <button type="button" class="adc-tbl-btn" data-target="line" aria-pressed="false">Ver como tabela</button>
          </figcaption>
          <ul class="adc-legend" aria-label="Legenda">
            <li><span class="adc-sw" style="background:#8B5CF6"></span>Devs</li>
            <li><span class="adc-sw" style="background:#0FA391"></span>Empresas</li>
          </ul>
          <div class="adc-plot" id="plot-line" role="group" aria-label="Gráfico de linhas: novos cadastros acumulados no período, devs e empresas"></div>
          <div class="adc-table-wrap" id="table-line" hidden></div>
        </figure>

        <figure class="adc-card adc-chart">
          <figcaption class="adc-chart-head">
            <h3 class="adc-h3">Evolução FREE vs PRO</h3>
            <button type="button" class="adc-tbl-btn" data-target="bars" aria-pressed="false">Ver como tabela</button>
          </figcaption>
          <ul class="adc-legend" aria-label="Legenda">
            <li><span class="adc-sw" style="background:#8B5CF6"></span>Devs PRO</li>
            <li><span class="adc-sw" style="background:#0FA391"></span>Empresas PRO</li>
            <li><span class="adc-sw" style="background:#55555f"></span>FREE</li>
          </ul>
          <div class="adc-plot" id="plot-bars" role="group" aria-label="Gráfico de barras: contas PRO e FREE de devs e empresas ao longo do período"></div>
          <div class="adc-table-wrap" id="table-bars" hidden></div>
          <p class="adc-note">Cada ponto passado considera uma conta PRO a partir da data do primeiro plano pago dela; o último ponto usa os assinantes PRO ativos hoje.</p>
        </figure>
      </section>

      <%- include('partials/admin-gerar-relatorio', { comTipo: false }) %>

    </div>
  </div>
</main>

<output class="adv-toast" id="toast" role="status" aria-live="polite"></output>

<footer class="adm-footer">
  <p>&copy; <%= new Date().getFullYear() %> Ápice. Painel do administrador.</p>
</footer>

<script src="/js/escape-html.js"></script>
<script src="/js/admin-relatorio.js"></script>
<script>
const $ = (id) => document.getElementById(id);
const API  = "/api/admin/reports/crescimento-de-usuarios";
// Cores categóricas validadas (scripts/validate_palette.js, modo escuro); FREE é o cinza neutro do "resto".
const { COR, SURFACE, INK, MUTED } = AR;

const { fmt, fmt1, hojeIso, diasAtras } = AR;

let report = null;
const page = { p: "90", from: diasAtras(89), to: hojeIso() };

function qs(sel) {
  return sel.p === "custom" ? `from=${sel.from}&to=${sel.to}` : `periodo=${sel.p}`;
}

// ── SVG (helpers em /js/admin-relatorio.js) ──
const { el, scaleFor, frame, topRound, tooltip } = AR;

// ── Gráfico de linhas: novos cadastros acumulados ──
function renderLine(data) {
  const plot = $("plot-line");
  plot.querySelectorAll("svg").forEach(n => n.remove());
  const W = 960, H = 280, m = { l: 48, r: 110, t: 16, b: 32 };
  const n = data.length, iw = W - m.l - m.r;
  const xAt = (i) => m.l + (n === 1 ? iw / 2 : (i * iw) / (n - 1));
  const maxV = Math.max(...data.map(d => Math.max(d.devs, d.empresas)), 0);
  const { svg, y } = frame(W, H, m, scaleFor(maxV), data.map(d => d.label), xAt);

  const series = [["devs", "Devs"], ["empresas", "Empresas"]];
  series.forEach(([k]) => {
    svg.appendChild(el("path", { d: data.map((d, i) => `${i ? "L" : "M"}${xAt(i)},${y(d[k])}`).join(""),
      fill: "none", stroke: COR[k], "stroke-width": 2, "stroke-linejoin": "round", "stroke-linecap": "round" }));
  });
  const marks = {};
  series.forEach(([k]) => {
    if (n > 31) return;
    marks[k] = data.map((d, i) => svg.appendChild(el("circle", { cx: xAt(i), cy: y(d[k]), r: 4, fill: COR[k], stroke: SURFACE, "stroke-width": 2 })));
  });
  // rótulos diretos no fim das linhas (afastados para não colidirem)
  const last = data[n - 1];
  let ly = series.map(([k, nome]) => ({ k, nome, y: y(last[k]) })).sort((a, b) => a.y - b.y);
  if (ly.length === 2 && ly[1].y - ly[0].y < 16) { const mid = (ly[0].y + ly[1].y) / 2; ly[0].y = mid - 8; ly[1].y = mid + 8; }
  ly.forEach(l => svg.appendChild(el("text", { x: xAt(n - 1) + 12, y: l.y + 4, fill: INK, "font-size": 12, "font-weight": 600 }, `${l.nome} ${fmt(last[l.k])}`)));

  const guide = el("line", { y1: m.t, y2: H - m.b, stroke: MUTED, "stroke-width": 1, "stroke-dasharray": "3 3", visibility: "hidden" });
  svg.insertBefore(guide, svg.children[1]);
  const hit = el("rect", { x: m.l, y: m.t, width: iw, height: H - m.t - m.b, fill: "transparent" });
  svg.appendChild(hit);
  plot.prepend(svg);

  const tip = tooltip(plot);
  hit.addEventListener("mousemove", ev => {
    const box = svg.getBoundingClientRect();
    const px = ((ev.clientX - box.left) / box.width) * W;
    const i = n === 1 ? 0 : Math.min(n - 1, Math.max(0, Math.round(((px - m.l) / iw) * (n - 1))));
    guide.setAttribute("x1", xAt(i)); guide.setAttribute("x2", xAt(i)); guide.setAttribute("visibility", "visible");
    Object.values(marks).forEach(a => a.forEach((c, j) => c.setAttribute("r", j === i ? 6 : 4)));
    const d = data[i];
    tip.show((xAt(i) / W) * 100, `${d.label} · acumulado no período`, [[COR.devs, "Devs", d.devs], [COR.empresas, "Empresas", d.empresas]]);
  });
  hit.addEventListener("mouseleave", () => {
    guide.setAttribute("visibility", "hidden");
    Object.values(marks).forEach(a => a.forEach(c => c.setAttribute("r", 4)));
    tip.hide();
  });
}

// ── Gráfico de barras: FREE × PRO ──
function renderBars(data) {
  const plot = $("plot-bars");
  plot.querySelectorAll("svg").forEach(n => n.remove());
  const W = 960, H = 300, m = { l: 48, r: 20, t: 16, b: 32 };
  const n = data.length, iw = W - m.l - m.r, gw = iw / n;
  const xAt = (i) => m.l + gw * i + gw / 2;
  const maxV = Math.max(...data.map(d => Math.max(d.devs_pro + d.devs_free, d.empresas_pro + d.empresas_free)), 0);
  const { svg, y } = frame(W, H, m, scaleFor(maxV), data.map(d => d.label), xAt);
  const base = y(0), barW = Math.max(6, Math.min(34, gw * 0.3)), gap = 6;

  function stack(x, pro, free, corPro) {
    const hPro = base - y(pro), hFree = base - y(pro + free) - hPro;
    if (free > 0) {
      const top = y(pro + free), h = Math.max(hFree - (pro > 0 ? 2 : 0), 1);
      svg.appendChild(el("path", { d: topRound(x, top, barW, h, 4), fill: COR.free }));
    }
    if (pro > 0) {
      svg.appendChild(el("path", free > 0
        ? { d: `M${x},${base}L${x},${y(pro)}L${x + barW},${y(pro)}L${x + barW},${base}Z`, fill: corPro }
        : { d: topRound(x, y(pro), barW, hPro, 4), fill: corPro }));
    }
  }
  data.forEach((d, i) => {
    const c = xAt(i);
    stack(c - barW - gap / 2, d.devs_pro, d.devs_free, COR.devs);
    stack(c + gap / 2, d.empresas_pro, d.empresas_free, COR.empresas);
  });

  const tip = tooltip(plot);
  data.forEach((d, i) => {
    const hit = el("rect", { x: m.l + gw * i, y: m.t, width: gw, height: H - m.t - m.b, fill: "transparent" });
    hit.addEventListener("mouseenter", () => tip.show((xAt(i) / W) * 100, d.label, [
      [COR.devs, "Devs PRO", d.devs_pro], [COR.free, "Devs FREE", d.devs_free],
      [COR.empresas, "Empresas PRO", d.empresas_pro], [COR.free, "Empresas FREE", d.empresas_free],
    ]));
    hit.addEventListener("mouseleave", () => tip.hide());
    svg.appendChild(hit);
  });
  plot.prepend(svg);
}

// ── Visão em tabela (alternativa acessível aos gráficos) ──
function tableHtml(caption, head, rows) {
  return `<table class="adr-table"><caption class="visually-hidden">${escapeHtml(caption)}</caption>
    <thead><tr>${head.map((h, i) => `<th scope="col"${i ? ' class="num"' : ""}>${escapeHtml(h)}</th>`).join("")}</tr></thead>
    <tbody>${rows.map(r => `<tr>${r.map((c, i) => i ? `<td class="num">${fmt(c)}</td>` : `<th scope="row">${escapeHtml(c)}</th>`).join("")}</tr>`).join("")}</tbody></table>`;
}

// ── Indicadores ──
function badge(el_, valor, sufixo, rotulo) {
  el_.className = "adc-badge";
  if (valor == null) { el_.textContent = "—"; el_.title = "Sem base de comparação no período"; return; }
  el_.classList.add(valor > 0 ? "is-up" : valor < 0 ? "is-down" : "is-flat");
  const num = Number.isInteger(valor) ? String(Math.abs(valor)) : fmt1(Math.abs(valor));
  el_.textContent = `${valor > 0 ? "+" : valor < 0 ? "−" : ""}${num}${sufixo}`;
  el_.title = rotulo;
}
function renderKpis(k) {
  $("k-devs").textContent = fmt(k.devs.total);
  badge($("k-devs-badge"), k.devs.variacao_pct, "%", "Variação da base de desenvolvedores no período");
  $("k-devs-bar").style.width = `${k.devs.total ? (k.devs.pro / k.devs.total) * 100 : 0}%`;
  $("k-devs-sub").textContent = `${fmt(k.devs.free)} FREE / ${fmt(k.devs.pro)} PRO`;
  $("k-emp").textContent = fmt(k.empresas.total);
  badge($("k-emp-badge"), k.empresas.variacao_pct, "%", "Variação da base de empresas no período");
  $("k-emp-bar").style.width = `${k.empresas.total ? (k.empresas.pro / k.empresas.total) * 100 : 0}%`;
  $("k-emp-sub").textContent = `${fmt(k.empresas.free)} FREE / ${fmt(k.empresas.pro)} PRO`;
  $("k-conv").textContent = `${fmt1(k.conversao.taxa)}%`;
  badge($("k-conv-badge"), k.conversao.variacao_pp, " p.p.", "Variação da taxa de conversão no período, em pontos percentuais");
  $("k-ratio").textContent = k.proporcao.razao == null ? "—" : `${fmt(k.proporcao.razao)}:1`;
}

function renderAll(r) {
  report = r;
  renderKpis(r.kpis);
  renderLine(r.cadastros);
  renderBars(r.planos);
  $("table-line").innerHTML = tableHtml("Novos cadastros acumulados no período", ["Ponto", "Devs", "Empresas"], r.cadastros.map(d => [d.label, d.devs, d.empresas]));
  $("table-bars").innerHTML = tableHtml("Contas PRO e FREE ao longo do período", ["Ponto", "Devs PRO", "Devs FREE", "Empresas PRO", "Empresas FREE"], r.planos.map(d => [d.label, d.devs_pro, d.devs_free, d.empresas_pro, d.empresas_free]));
}

async function fetchReport(sel) {
  const res = await fetch(`${API}?${qs(sel)}`);
  const data = await res.json().catch(() => ({}));
  if (!res.ok) throw new Error(data.error || "Erro ao carregar o relatório.");
  return data;
}

let toastTimer;
function toast(msg, isErr = false) {
  const t = $("toast"); t.textContent = msg; t.classList.toggle("is-error", isErr); t.classList.add("show");
  clearTimeout(toastTimer); toastTimer = setTimeout(() => t.classList.remove("show"), 2800);
}

// ── Período dos gráficos ──
async function aplicarPagina() {
  const evo = $("evo"); evo.setAttribute("aria-busy", "true");
  try { renderAll(await fetchReport(page)); }
  catch (err) { toast(err.message, true); }
  finally { evo.setAttribute("aria-busy", "false"); }
}
$("seg").querySelectorAll("[data-p]").forEach(btn => btn.addEventListener("click", () => {
  page.p = btn.dataset.p;
  $("seg").querySelectorAll("[data-p]").forEach(b => b.setAttribute("aria-pressed", String(b === btn)));
  $("range-form").hidden = page.p !== "custom";
  if (page.p === "custom") { $("r-from").value = page.from; $("r-to").value = page.to; $("r-from").focus(); return; }
  aplicarPagina();
}));
$("range-form").addEventListener("submit", async e => {
  e.preventDefault();
  const from = $("r-from").value, to = $("r-to").value;
  $("range-error").textContent = "";
  if (!from || !to) { $("range-error").textContent = "Informe as duas datas."; return; }
  page.from = from; page.to = to;
  try { renderAll(await fetchReport(page)); } catch (err) { $("range-error").textContent = err.message; }
});
$("r-to").max = hojeIso();

document.querySelectorAll(".adc-tbl-btn").forEach(btn => btn.addEventListener("click", () => {
  const alvo = btn.dataset.target, ativo = btn.getAttribute("aria-pressed") !== "true";
  btn.setAttribute("aria-pressed", String(ativo));
  btn.textContent = ativo ? "Ver gráfico" : "Ver como tabela";
  $(`plot-${alvo}`).hidden = ativo; $(`table-${alvo}`).hidden = !ativo;
}));

// ── Gerar relatório (pop-up) ──
AR.initGerar({ api: API, comTipo: false, toast });

(async function init() {
  try {
    const r = await fetchReport(page);
    $("loading").hidden = true; $("content").hidden = false;
    renderAll(r);   // depois de mostrar: o SVG usa getBoundingClientRect só nos eventos
  } catch (err) {
    console.error(err);
    $("loading").innerHTML = `
      <div role="alert">
        <p class="adm-error">Erro ao carregar o relatório.</p>
        <a class="adm-error-link" href="/admin/relatorios">← Voltar às categorias</a>
      </div>`;
  }
})();
</script>

</body>
</html>
