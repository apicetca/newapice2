<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/webp" href="/img/principal-gradiente.webp" />
  <meta name="description" content="Relatório de atividade das empresas — Ápice." />
  <title>Ápice — Admin · <%= categoria.titulo %></title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/design-system.css" />
  <link rel="stylesheet" href="/css/header.css" />
  <link rel="stylesheet" href="/css/admin-dashboard.css" />
  <link rel="stylesheet" href="/css/admin-vagas.css" />
  <link rel="stylesheet" href="/css/admin-usuarios.css" />
  <link rel="stylesheet" href="/css/admin-relatorios.css" />
  <link rel="stylesheet" href="/css/admin-crescimento.css" />
  <link rel="stylesheet" href="/css/admin-desempenho.css" />
  <link rel="stylesheet" href="/css/admin-matchs-relatorio.css" />
</head>
<body>

  <%- include('partials/header-admin', { currentPage: 'admin-relatorios' }) %>

<main class="adm-main" id="main-content">
  <div class="adc-wrap">

    <a href="/admin/relatorios" class="adr-back">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      Voltar
    </a>

    <header class="adr-head">
      <h1 class="adr-title"><%= categoria.titulo %></h1>
      <p class="adr-sub"><%= categoria.descricao %></p>
    </header>

    <section class="adm-loading" id="loading" role="status" aria-live="polite">
      <span class="adm-spinner" aria-hidden="true"></span>
      <p>Carregando relatório...</p>
    </section>

    <div id="content" hidden>

      <%# ── Indicadores ── %>
      <section aria-labelledby="h-kpis">
        <h2 class="visually-hidden" id="h-kpis">Indicadores</h2>
        <ul class="adc-kpis">
          <li class="adc-card">
            <p class="adc-kpi-title">Total de empresas ativas</p>
            <p class="adc-kpi-row"><strong class="adc-kpi-value" id="k-emp"></strong><span class="adc-badge" id="k-emp-badge"></span></p>
            <span class="adc-split" aria-hidden="true"><span id="k-emp-bar"></span></span>
            <p class="adc-kpi-sub" id="k-emp-sub"></p>
          </li>
          <li class="adc-card">
            <p class="adc-kpi-title">Vagas publicadas</p>
            <p class="adc-kpi-row"><strong class="adc-kpi-value" id="k-vagas"></strong><span class="adc-badge" id="k-vagas-badge"></span></p>
            <p class="adc-kpi-sub" id="k-vagas-sub"></p>
          </li>
          <li class="adc-card">
            <p class="adc-kpi-title">Candidaturas enviadas</p>
            <p class="adc-kpi-row"><strong class="adc-kpi-value" id="k-cand"></strong><span class="adc-badge" id="k-cand-badge"></span></p>
            <p class="adc-kpi-sub">Recebidas pelas vagas no período</p>
          </li>
          <li class="adc-card">
            <p class="adc-kpi-title">Média de conexões por empresa</p>
            <p class="adc-kpi-row"><strong class="adc-kpi-value" id="k-con"></strong><span class="adc-badge" id="k-con-badge"></span></p>
            <p class="adc-kpi-sub" id="k-con-sub"></p>
          </li>
        </ul>
      </section>

      <%# ── Dinâmica e engajamento ── %>
      <section class="adc-section" aria-labelledby="h-din" aria-busy="false" id="evo">
        <div class="adc-evo-head">
          <h2 class="adc-h2" id="h-din">Dinâmica e engajamento</h2>
          <fieldset class="adv-group adc-seg" id="seg" aria-label="Período do relatório">
            <button type="button" class="adv-chip" data-p="7"      aria-pressed="false">7 dias</button>
            <button type="button" class="adv-chip" data-p="30"     aria-pressed="true">30 dias</button>
            <button type="button" class="adv-chip" data-p="90"     aria-pressed="false">90 dias</button>
            <button type="button" class="adv-chip" data-p="custom" aria-pressed="false">Personalizado</button>
          </fieldset>
        </div>

        <form class="adc-range" id="range-form" hidden novalidate>
          <div class="adv-field"><label for="r-from">De</label><input type="date" id="r-from" required /></div>
          <div class="adv-field"><label for="r-to">Até</label><input type="date" id="r-to" required /></div>
          <button type="submit" class="adv-btn adv-btn--primary">Aplicar</button>
          <p class="adv-form-error" id="range-error" role="alert"></p>
        </form>

        <figure class="adc-card adc-chart">
          <figcaption class="adc-chart-head">
            <h3 class="adc-h3">Comparativo de candidaturas por empresa</h3>
            <button type="button" class="adc-tbl-btn" data-target="cats" aria-pressed="false">Ver como tabela</button>
          </figcaption>
          <div class="adc-plot" id="plot-cats" role="group" aria-label="Gráfico de barras: candidaturas recebidas no período pelas empresas com mais candidaturas"></div>
          <div class="adc-table-wrap" id="table-cats" hidden></div>
          <p class="adc-note">As seis empresas que mais receberam candidaturas no período escolhido.</p>
        </figure>
      </section>

      <%# ── Ranking de empresas ── %>
      <section class="adc-section" aria-labelledby="h-rank">
        <div class="adc-evo-head">
          <h2 class="adc-h2" id="h-rank">Ranking de empresas</h2>
          <p class="add-period" id="rank-period"></p>
        </div>
        <section class="adc-card add-rank" aria-labelledby="h-top">
          <h3 class="adc-h3" id="h-top">Empresas mais ativas</h3>
          <div class="adc-table-wrap">
            <table class="adr-table add-table">
              <caption class="visually-hidden">Empresas com mais vagas publicadas e matchs no período</caption>
              <thead>
                <tr>
                  <th scope="col">Empresa</th>
                  <th scope="col" class="num">Vagas</th>
                  <th scope="col" class="num">Matchs</th>
                  <th scope="col" class="num">Plano</th>
                  <th scope="col" class="num">Ações</th>
                </tr>
              </thead>
              <tbody id="rank-tbody"></tbody>
            </table>
          </div>
          <p class="adm-empty" id="rank-empty" hidden>Nenhuma atividade de empresas no período.</p>
        </section>
      </section>

      <%- include('partials/admin-gerar-relatorio', { comTipo: false }) %>

    </div>
  </div>
</main>

<output class="adv-toast" id="toast" role="status" aria-live="polite"></output>

<footer class="adm-footer">
  <p>&copy; <%= new Date().getFullYear() %> Ápice. Painel do administrador.</p>
</footer>

<script src="/js/escape-html.js"></script>
<script src="/js/admin-relatorio.js"></script>
<script>
const $ = (id) => document.getElementById(id);
const API = "/api/admin/reports/atividade-das-empresas";
const { COR, fmt, fmt1, hojeIso, diasAtras, qs, el, scaleFor, frame, topRound, tooltip } = AR;

const page = { p: "30", from: diasAtras(29), to: hojeIso() };
const CORES = ["#E2E52B", "#59E435", "#60a5fa", "#c084fc", "#f87171", "#fbbf24"];
const dataBr = (iso) => `${iso.slice(8, 10)}/${iso.slice(5, 7)}/${iso.slice(0, 4)}`;
const initials = (s) => String(s || "?").trim().split(/\s+/).slice(0, 2).map(w => w.charAt(0)).join("").toUpperCase() || "?";
const formatCnpj = (c) => { const d = String(c ?? "").replace(/\D/g, ""); return d.length === 14 ? d.replace(/^(\d{2})(\d{3})(\d{3})(\d{4})(\d{2})$/, "$1.$2.$3/$4-$5") : (c || ""); };
const curto = (nome) => (nome.length > 13 ? nome.slice(0, 12) + "…" : nome);

// ── Gráfico de barras: candidaturas por empresa (uma série) ──
function renderChart(data) {
  const plot = $("plot-cats");
  plot.querySelectorAll("svg").forEach(n => n.remove());
  const W = 960, H = 290, m = { l: 48, r: 20, t: 16, b: 32 };
  const n = Math.max(data.length, 1), iw = W - m.l - m.r, gw = iw / n;
  const xAt = (i) => m.l + gw * i + gw / 2;
  const maxV = Math.max(...data.map(d => d.candidaturas), 0);
  const { svg, y } = frame(W, H, m, scaleFor(maxV), data.map(d => curto(d.nome)), xAt);
  const base = y(0), barW = Math.max(10, Math.min(56, gw * 0.4));

  data.forEach((d, i) => svg.appendChild(el("path", { d: topRound(xAt(i) - barW / 2, y(d.candidaturas), barW, base - y(d.candidaturas), 4), fill: COR.empresas })));

  const tip = tooltip(plot);
  data.forEach((d, i) => {
    const hit = el("rect", { x: m.l + gw * i, y: m.t, width: gw, height: H - m.t - m.b, fill: "transparent" });
    hit.addEventListener("mouseenter", () => tip.show((xAt(i) / W) * 100, d.nome, [[COR.empresas, "Candidaturas", d.candidaturas], [COR.devs, "Vagas publicadas", d.vagas]]));
    hit.addEventListener("mouseleave", () => tip.hide());
    svg.appendChild(hit);
  });
  if (!data.length) svg.appendChild(el("text", { x: W / 2, y: H / 2, "text-anchor": "middle", fill: AR.MUTED, "font-size": 13 }, "Sem candidaturas no período."));
  plot.prepend(svg);
}

function tableChart(rows) {
  const corpo = rows.length
    ? rows.map(r => `<tr><th scope="row">${escapeHtml(r.nome)}</th><td class="num">${fmt(r.candidaturas)}</td><td class="num">${fmt(r.vagas)}</td></tr>`).join("")
    : '<tr><td colspan="3">Sem candidaturas no período.</td></tr>';
  return `<table class="adr-table"><caption class="visually-hidden">Candidaturas recebidas por empresa no período</caption>
    <thead><tr><th scope="col">Empresa</th><th scope="col" class="num">Candidaturas</th><th scope="col" class="num">Vagas publicadas</th></tr></thead>
    <tbody>${corpo}</tbody></table>`;
}

function badge(node, valor, sufixo, rotulo) {
  node.className = "adc-badge";
  if (valor == null) { node.textContent = "—"; node.title = "Sem base de comparação no período"; return; }
  node.classList.add(valor > 0 ? "is-up" : valor < 0 ? "is-down" : "is-flat");
  const num = Number.isInteger(valor) ? String(Math.abs(valor)) : fmt1(Math.abs(valor));
  node.textContent = `${valor > 0 ? "+" : valor < 0 ? "−" : ""}${num}${sufixo}`;
  node.title = rotulo;
}

function renderKpis(k) {
  $("k-emp").textContent = fmt(k.empresas.total);
  badge($("k-emp-badge"), k.empresas.variacao_pct, "%", "Variação da base de empresas no período");
  $("k-emp-bar").style.width = `${k.empresas.total ? (k.empresas.pro / k.empresas.total) * 100 : 0}%`;
  $("k-emp-sub").textContent = `${fmt(k.empresas.free)} FREE / ${fmt(k.empresas.pro)} PRO`;
  $("k-vagas").textContent = fmt(k.vagas.total);
  badge($("k-vagas-badge"), k.vagas.variacao_pct, "%", "Variação das vagas publicadas em relação ao período anterior");
  $("k-vagas-sub").textContent = `${fmt(k.vagas.presenciais)} presenciais / ${fmt(k.vagas.hibridas)} híbridas / ${fmt(k.vagas.remotas)} remotas`;
  $("k-cand").textContent = fmt(k.candidaturas.total);
  badge($("k-cand-badge"), k.candidaturas.variacao_pct, "%", "Variação das candidaturas em relação ao período anterior");
  $("k-con").textContent = fmt1(k.conexoes.media);
  badge($("k-con-badge"), k.conexoes.variacao_pct, "%", "Variação dos matchs aceitos em relação ao período anterior");
  $("k-con-sub").textContent = `${fmt(k.conexoes.total)} matchs aceitos no período`;
}

function renderRanking(rows) {
  $("rank-empty").hidden = rows.length > 0;
  $("rank-tbody").innerHTML = rows.map(e => `
    <tr>
      <th scope="row"><div class="adu-person"><span class="adm-avatar adu-logo" style="background:${CORES[e.id % CORES.length]}" aria-hidden="true">${escapeHtml(initials(e.nome))}</span>
        <span class="adu-person-txt"><span class="adu-name add-company">${escapeHtml(e.nome)}</span>${e.cnpj ? `<span class="adu-login">${escapeHtml(formatCnpj(e.cnpj))}</span>` : ""}</span></div></th>
      <td class="num">${fmt(e.vagas)}</td>
      <td class="num">${fmt(e.matchs)}</td>
      <td class="num">${escapeHtml(e.plano)}</td>
      <td class="num"><a class="adv-icon-btn" href="/admin/empresas/${Number(e.id)}" aria-label="Ver perfil de ${escapeHtml(e.nome)}">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></a></td>
    </tr>`).join("");
}

function renderAll(r) {
  renderKpis(r.kpis);
  renderChart(r.grafico);
  $("table-cats").innerHTML = tableChart(r.grafico);
  renderRanking(r.ranking);
  $("rank-period").textContent = `Período: ${dataBr(r.periodo.from)} a ${dataBr(r.periodo.to)}`;
}

async function fetchReport(sel) {
  const res = await fetch(`${API}?${qs(sel)}`);
  const data = await res.json().catch(() => ({}));
  if (!res.ok) throw new Error(data.error || "Erro ao carregar o relatório.");
  return data;
}

let toastTimer;
function toast(msg, isErr = false) {
  const t = $("toast"); t.textContent = msg; t.classList.toggle("is-error", isErr); t.classList.add("show");
  clearTimeout(toastTimer); toastTimer = setTimeout(() => t.classList.remove("show"), 2800);
}

// ── Período ──
async function aplicarPagina() {
  const evo = $("evo"); evo.setAttribute("aria-busy", "true");
  try { renderAll(await fetchReport(page)); }
  catch (err) { toast(err.message, true); }
  finally { evo.setAttribute("aria-busy", "false"); }
}
$("seg").querySelectorAll("[data-p]").forEach(btn => btn.addEventListener("click", () => {
  page.p = btn.dataset.p;
  $("seg").querySelectorAll("[data-p]").forEach(b => b.setAttribute("aria-pressed", String(b === btn)));
  $("range-form").hidden = page.p !== "custom";
  if (page.p === "custom") { $("r-from").value = page.from; $("r-to").value = page.to; $("r-from").focus(); return; }
  aplicarPagina();
}));
$("range-form").addEventListener("submit", async e => {
  e.preventDefault();
  const from = $("r-from").value, to = $("r-to").value;
  $("range-error").textContent = "";
  if (!from || !to) { $("range-error").textContent = "Informe as duas datas."; return; }
  page.from = from; page.to = to;
  try { renderAll(await fetchReport(page)); } catch (err) { $("range-error").textContent = err.message; }
});
$("r-to").max = hojeIso();

document.querySelectorAll(".adc-tbl-btn").forEach(btn => btn.addEventListener("click", () => {
  const alvo = btn.dataset.target, ativo = btn.getAttribute("aria-pressed") !== "true";
  btn.setAttribute("aria-pressed", String(ativo));
  btn.textContent = ativo ? "Ver gráfico" : "Ver como tabela";
  $(`plot-${alvo}`).hidden = ativo; $(`table-${alvo}`).hidden = !ativo;
}));

// ── Gerar relatório (pop-up) ──
AR.initGerar({ api: API, comTipo: false, toast });

(async function init() {
  try {
    const r = await fetchReport(page);
    $("loading").hidden = true; $("content").hidden = false;
    renderAll(r);
  } catch (err) {
    console.error(err);
    $("loading").innerHTML = `
      <div role="alert">
        <p class="adm-error">Erro ao carregar o relatório.</p>
        <a class="adm-error-link" href="/admin/relatorios">← Voltar às categorias</a>
      </div>`;
  }
})();
</script>

</body>
</html>
