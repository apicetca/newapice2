<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/webp" href="/img/principal-gradiente.webp" />
  <meta name="description" content="Configurações do painel do administrador — Ápice." />
  <title>Ápice — Admin · Configurações</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/design-system.css" />
  <link rel="stylesheet" href="/css/header.css" />
  <link rel="stylesheet" href="/css/admin-dashboard.css" />
  <link rel="stylesheet" href="/css/admin-relatorios.css" />
</head>
<body>

  <%- include('partials/header-admin', { currentPage: 'admin-configuracoes' }) %>

<main class="adm-main" id="main-content">
  <div class="adr-wrap">

    <h1 class="visually-hidden">Configurações</h1>

    <ul class="adr-list adr-list--text" aria-label="Categorias de configuração">
      <% categorias.forEach(c => { %>
      <li>
        <a class="adr-card" href="/admin/configuracoes/<%= c.slug %>">
          <span class="adr-txt">
            <span class="adr-card-title"><%= c.titulo %></span>
            <span class="adr-card-desc"><%= c.descricao %></span>
          </span>
          <svg class="adr-chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
        </a>
      </li>
      <% }) %>
    </ul>

  </div>
</main>

<footer class="adm-footer">
  <p>&copy; <%= new Date().getFullYear() %> Ápice. Painel do administrador.</p>
</footer>

</body>
</html>
