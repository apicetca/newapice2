<%
  const icons = {
    usuarios: '<path d="M16 20v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="8" r="3.5"/><path d="M22 20v-2a4 4 0 0 0-3-3.87"/><path d="M16 4.13a3.5 3.5 0 0 1 0 6.74"/>',
    vagas: '<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M9 7v13M15 7v13"/>',
    matchs: '<path d="M17 2l3 3-3 3"/><path d="M4 11V9a4 4 0 0 1 4-4h12"/><path d="M7 22l-3-3 3-3"/><path d="M20 13v2a4 4 0 0 1-4 4H4"/>',
    empresas: '<rect x="4" y="3" width="12" height="18" rx="1.5"/><path d="M16 9h4v12h-4M8 7h4M8 11h4M8 15h4"/>',
    uso: '<path d="M6 20V10M12 20V4M18 20v-7"/>',
    planos: '<path d="M3 8l4.5 4L12 5l4.5 7L21 8l-2 11H5z"/><path d="M5 22h14"/>'
  };
%>
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/webp" href="/img/principal-gradiente.webp" />
  <meta name="description" content="Relatórios da plataforma — Ápice." />
  <title>Ápice — Admin · Relatórios</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/design-system.css" />
  <link rel="stylesheet" href="/css/header.css" />
  <link rel="stylesheet" href="/css/admin-dashboard.css" />
  <link rel="stylesheet" href="/css/admin-relatorios.css" />
</head>
<body>

  <%- include('partials/header-admin', { currentPage: 'admin-relatorios' }) %>

<main class="adm-main" id="main-content">
  <div class="adr-wrap">

    <header class="adr-head">
      <h1 class="adr-title">Visualizar relatórios</h1>
      <p class="adr-sub">Selecione uma categoria</p>
    </header>

    <ul class="adr-list" aria-label="Categorias de relatório">
      <% categorias.forEach(c => { %>
      <li>
        <a class="adr-card" href="/admin/relatorios/<%= c.slug %>">
          <span class="adr-ico" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><%- icons[c.icon] %></svg>
          </span>
          <span class="adr-txt">
            <span class="adr-card-title"><%= c.titulo %></span>
            <span class="adr-card-desc"><%= c.descricao %></span>
          </span>
          <svg class="adr-chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
        </a>
      </li>
      <% }) %>
    </ul>

  </div>
</main>

<footer class="adm-footer">
  <p>&copy; <%= new Date().getFullYear() %> Ápice. Painel do administrador.</p>
</footer>

</body>
</html>
