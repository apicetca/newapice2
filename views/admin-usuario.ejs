<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/webp" href="/img/principal-gradiente.webp" />
  <meta name="description" content="Perfil do desenvolvedor — painel do administrador." />
  <title>Ápice — Admin · Perfil do desenvolvedor</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/design-system.css" />
  <link rel="stylesheet" href="/css/header.css" />
  <link rel="stylesheet" href="/css/admin-dashboard.css" />
  <link rel="stylesheet" href="/css/admin-vagas.css" />
  <link rel="stylesheet" href="/css/admin-vaga.css" />
  <link rel="stylesheet" href="/css/admin-usuarios.css" />
  <link rel="stylesheet" href="/css/admin-usuario.css" />
</head>
<body>

  <%- include('partials/header-admin', { currentPage: 'admin-usuarios' }) %>

<main class="adm-main" id="main-content">

  <section class="adm-loading" id="loading" role="status" aria-live="polite">
    <span class="adm-spinner" aria-hidden="true"></span>
    <p>Carregando perfil...</p>
  </section>

  <div class="adj-wrap" id="content" hidden>

    <a href="/admin/usuarios" class="adj-back">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      Voltar
    </a>

    <%# ── Cabeçalho do perfil ── %>
    <header class="adj-card adu-head">
      <div class="adu-head-main">
        <div id="head-avatar"></div>
        <div class="adu-head-txt">
          <h1 class="adu-h1" id="p-name"></h1>
          <p class="adu-head-email" id="p-email"></p>
          <ul class="adu-badges" id="p-badges" aria-label="Nível e GitHub"></ul>
          <p class="adu-since" id="p-since"></p>
        </div>
        <ul class="adu-counters" aria-label="Habilidades">
          <li><strong id="c-skills">0</strong><span>habilidades</span></li>
          <li><strong id="c-master">0</strong><span>dominadas</span></li>
        </ul>
      </div>
      <div class="adu-head-foot">
        <p class="adu-status" id="p-status"></p>
        <div class="adv-actions">
          <a class="adv-icon-btn" id="btn-mail" href="#" aria-label="Enviar e-mail ao desenvolvedor">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
          </a>
          <button type="button" class="adv-icon-btn" id="btn-edit" aria-label="Editar dados pessoais">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
          </button>
          <button type="button" class="adv-icon-btn" id="btn-status"></button>
        </div>
      </div>
    </header>
    <p class="adj-error" id="status-error" role="alert"></p>

    <%# ── Informações pessoais ── %>
    <section class="adj-card" aria-labelledby="h-pessoais">
      <h2 class="adj-h2" id="h-pessoais">Informações pessoais</h2>
      <form id="personal-form" novalidate>
        <div class="adv-form-grid">
          <div class="adv-field">
            <label for="f-nome">Nome</label>
            <input type="text" id="f-nome" maxlength="100" required autocomplete="off" />
          </div>
          <div class="adv-field">
            <label for="f-sobrenome">Sobrenome<span class="adv-field-opt">(Opcional)</span></label>
            <input type="text" id="f-sobrenome" maxlength="100" placeholder="Sobrenome" autocomplete="off" />
          </div>
          <div class="adv-field">
            <label for="f-github">Usuário GitHub<span class="adv-field-opt">(Opcional)</span></label>
            <input type="text" id="f-github" maxlength="39" autocomplete="off" />
          </div>
          <div class="adv-field">
            <label for="f-nivel">Nível atual</label>
            <select id="f-nivel">
              <option value="iniciante">Iniciante</option>
              <option value="intermediario">Intermediário</option>
              <option value="avancado">Avançado</option>
            </select>
          </div>
        </div>
        <p class="adv-form-error" id="personal-error" role="alert"></p>
        <div class="adu-form-foot"><button type="submit" class="adv-btn adv-btn--primary" id="personal-save">Salvar dados</button></div>
      </form>
    </section>

    <%# ── Habilidades ── %>
    <section class="adj-card" aria-labelledby="h-skills">
      <h2 class="adj-h2" id="h-skills">Habilidades</h2>
      <p class="adu-empty" id="skills-empty" hidden>Nenhuma habilidade detectada ou declarada ainda.</p>
      <ul class="adu-skills" id="skills-list"></ul>

      <form class="adu-add" id="skill-form" aria-label="Adicionar habilidade manualmente">
        <div class="adv-field">
          <label for="s-skill">Adicionar manualmente</label>
          <select id="s-skill"><option value="">Selecione uma habilidade</option></select>
        </div>
        <div class="adv-field">
          <label for="s-nivel">Nível</label>
          <select id="s-nivel">
            <option value="iniciante">Iniciante</option>
            <option value="intermediario" selected>Intermediário</option>
            <option value="avancado">Avançado</option>
          </select>
        </div>
        <button type="submit" class="adv-btn" id="skill-add">+ Adicionar</button>
      </form>
      <p class="adv-form-error" id="skill-error" role="alert"></p>
    </section>

    <%# ── Repositórios ── %>
    <section class="adj-card" aria-labelledby="h-repos">
      <h2 class="adj-h2" id="h-repos">Repositórios no perfil <span class="adu-count" id="repos-count"></span></h2>
      <p class="adj-body">Repositórios do GitHub que aparecem no perfil público.</p>
      <p class="adu-empty" id="repos-empty" hidden>Nenhum repositório público no perfil.</p>
      <ul class="adu-repos" id="repos-list"></ul>
    </section>

    <%# ── Plano ── %>
    <section class="adj-card" aria-labelledby="h-plano">
      <div class="adu-plan-head">
        <h2 class="adj-h2" id="h-plano">Plano do usuário</h2>
        <p class="adu-next" id="plan-next" hidden></p>
      </div>
      <p class="adu-plan-name" id="plan-name"></p>
      <ul class="adu-benefits" id="plan-benefits"></ul>
      <div class="adv-field adu-plan-change">
        <label for="plan-select">Alterar plano</label>
        <select id="plan-select">
          <option value="dev_free">FREE</option>
          <option value="dev_pro">PRO</option>
        </select>
      </div>
      <p class="adv-form-error" id="plan-error" role="alert"></p>
    </section>

    <%# ── Conta ── %>
    <section class="adj-card" aria-labelledby="h-conta">
      <h2 class="adj-h2" id="h-conta">Informações da conta</h2>
      <dl class="adu-account">
        <div><dt>E-mail</dt><dd id="acc-email"></dd></div>
        <div><dt>Tipo de conta</dt><dd>Desenvolvedor</dd></div>
        <div><dt>Login</dt><dd id="acc-login"></dd></div>
        <div><dt>Membro desde</dt><dd id="acc-since"></dd></div>
      </dl>
    </section>

    <%- include('partials/admin-excluir-conta', { rotulo: 'desenvolvedor' }) %>

  </div>
</main>

<output class="adv-toast" id="toast" role="status" aria-live="polite"></output>

<footer class="adm-footer">
  <p>&copy; <%= new Date().getFullYear() %> Ápice. Painel do administrador.</p>
</footer>

<script src="/js/escape-html.js"></script>
<script src="/js/admin-excluir-conta.js"></script>
<script>
const USER_ID = <%- Number(userId) %>;
const NIVEL_LABEL = { iniciante: "Iniciante", intermediario: "Intermediário", avancado: "Avançado" };
const $ = (id) => document.getElementById(id);

let dev = null;

const fullName = (d) => `${d.nome} ${d.sobrenome}`.trim();
const initials = (s) => String(s || "?").trim().split(/\s+/).slice(0, 2).map(w => w.charAt(0)).join("").toUpperCase() || "?";
const safeUrl = (u) => /^https?:\/\//i.test(u || "") ? u : "";
const longDate = (raw, opts) => raw ? new Date(raw).toLocaleDateString("pt-BR", opts) : "—";

function activityText(s) {
  if (s == null) return "Sem atividade registrada";
  const min = Math.floor(s / 60), h = Math.floor(min / 60), d = Math.floor(h / 24);
  if (min < 5)  return "Online agora";
  if (min < 60) return `Online há ${min} min`;
  if (h < 24)   return `Online há ${h} ${h === 1 ? "hora" : "horas"}`;
  if (d < 2)    return "Online ontem";
  return `Online há ${d} dias`;
}

let toastTimer;
function toast(msg, isErr = false) {
  const el = $("toast");
  el.textContent = msg; el.classList.toggle("is-error", isErr); el.classList.add("show");
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => el.classList.remove("show"), 2800);
}

async function api(method, path, body) {
  const res = await fetch(`/api/admin/users/${USER_ID}${path}`, {
    method, headers: { "Content-Type": "application/json" }, body: body ? JSON.stringify(body) : undefined,
  });
  const data = await res.json().catch(() => ({}));
  if (!res.ok) throw new Error(data.error || "Erro ao atualizar. Tente novamente.");
  return data;
}

const ICON_BAN = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m5.6 5.6 12.8 12.8"/></svg>';
const ICON_OK = '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8 12.5 2.8 2.8L16 9.5"/></svg>';

function renderHead() {
  const nome = fullName(dev);
  document.title = `Ápice — Admin · ${nome || dev.email}`;
  $("head-avatar").innerHTML = safeUrl(dev.avatar_url)
    ? `<img class="adu-avatar" src="${escapeHtml(dev.avatar_url)}" alt="" width="72" height="72" />`
    : `<span class="adu-avatar" aria-hidden="true">${escapeHtml(initials(nome || dev.email))}</span>`;
  $("p-name").textContent = nome || "Sem nome";
  $("p-email").textContent = dev.email;
  $("p-badges").innerHTML =
    `<li class="adu-badge adu-badge--level">${NIVEL_LABEL[dev.nivel] ?? "—"}</li>` +
    (dev.github_login ? `<li class="adu-badge adu-badge--gh"><a href="https://github.com/${encodeURIComponent(dev.github_login)}" target="_blank" rel="noopener">@${escapeHtml(dev.github_login)}</a></li>` : "");
  $("p-since").textContent = `Desde ${longDate(dev.created_at, { month: "long", year: "numeric" })}`;
  $("c-skills").textContent = dev.skills.length;
  $("c-master").textContent = dev.skills.filter(s => s.confidence >= 60).length;

  $("p-status").innerHTML = `Status: <strong>${dev.active ? "Ativo" : "Suspenso"}</strong><span>${escapeHtml(activityText(dev.visto_ha_segundos))}</span>`;
  $("btn-mail").href = `mailto:${dev.email}`;
  const st = $("btn-status");
  st.className = "adv-icon-btn " + (dev.active ? "adv-icon-btn--danger" : "adv-icon-btn--ok");
  st.innerHTML = dev.active ? ICON_BAN : ICON_OK;
  st.setAttribute("aria-label", dev.active ? "Suspender desenvolvedor" : "Reativar desenvolvedor");
}

function renderForm() {
  $("f-nome").value = dev.nome; $("f-sobrenome").value = dev.sobrenome;
  $("f-github").value = dev.github_login; $("f-nivel").value = dev.nivel;
}

function renderSkills() {
  const list = $("skills-list");
  list.innerHTML = "";
  $("skills-empty").hidden = dev.skills.length > 0;
  dev.skills.forEach(s => {
    const declarada = s.source === "manual" || s.nivel_declarado;
    const origem = declarada ? `Declarada${s.nivel_declarado ? ` · ${NIVEL_LABEL[s.nivel_declarado] ?? s.nivel_declarado}` : ""}` : "Detectado no GitHub";
    const li = document.createElement("li");
    li.className = "adu-skill";
    li.innerHTML = `
      <span class="adu-skill-top"><span class="adu-skill-name">${escapeHtml(s.name)}</span><span class="adu-skill-pct">${Number(s.confidence)}%</span></span>
      <span class="adu-skill-origin${declarada ? " is-manual" : ""}">${escapeHtml(origem)}</span>
      ${declarada ? `<button type="button" class="adu-skill-x" data-skill="${Number(s.skill_id)}" aria-label="Remover declaração de ${escapeHtml(s.name)}">×</button>` : ""}`;
    list.appendChild(li);
  });
}

function renderRepos() {
  $("repos-count").textContent = dev.repos.length;
  $("repos-empty").hidden = dev.repos.length > 0;
  $("repos-list").innerHTML = dev.repos.map(r =>
    `<li><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20V3H6.5A2.5 2.5 0 0 0 4 5.5z"/></svg>${escapeHtml(r.repo_name)}</li>`).join("");
}

function renderPlan() {
  $("plan-name").textContent = `${dev.plan.name} (${dev.plan.code === "dev_pro" ? "plano mensal" : "plano gratuito"})`;
  const next = $("plan-next");
  next.hidden = !dev.plan.next_payment_date;
  if (dev.plan.next_payment_date) {
    const [y, m, d] = dev.plan.next_payment_date.split("-").map(Number);
    next.textContent = `Próxima cobrança: ${new Date(y, m - 1, d).toLocaleDateString("pt-BR", { day: "numeric", month: "short", year: "numeric" })}`;
  }
  $("plan-benefits").innerHTML = dev.plan.benefits.map(b => `<li>${escapeHtml(b)}</li>`).join("");
  $("plan-select").value = dev.plan.code;
}

function renderAccount() {
  $("acc-email").textContent = dev.email;
  $("acc-login").textContent = dev.login_github && dev.login_email ? "GitHub ou e-mail e senha" : dev.login_github ? "GitHub" : "E-mail e senha";
  $("acc-since").textContent = longDate(dev.created_at, { day: "numeric", month: "long", year: "numeric" });
}

function renderAll() { renderHead(); renderForm(); renderSkills(); renderRepos(); renderPlan(); renderAccount(); }

async function load() {
  const res = await fetch(`/api/admin/users/${USER_ID}`);
  if (res.status === 404) { location.replace("/admin/usuarios"); return; }
  if (!res.ok) throw new Error("Falha ao carregar");
  dev = await res.json();
  renderAll();
}

// ── Ações ──
$("btn-edit").addEventListener("click", () => { $("f-nome").scrollIntoView({ block: "center" }); $("f-nome").focus(); });

$("btn-status").addEventListener("click", async e => {
  const btn = e.currentTarget; btn.disabled = true; $("status-error").textContent = "";
  try {
    await api("PATCH", "", { active: !dev.active });
    toast(dev.active ? "Desenvolvedor suspenso." : "Desenvolvedor reativado.");
    await load();
  } catch (err) { $("status-error").textContent = err.message; }
  finally { btn.disabled = false; }
});

$("personal-form").addEventListener("submit", async e => {
  e.preventDefault();
  const btn = $("personal-save"); btn.disabled = true; $("personal-error").textContent = "";
  try {
    await api("PATCH", "", { nome: $("f-nome").value, sobrenome: $("f-sobrenome").value, nivel: $("f-nivel").value, github_login: $("f-github").value });
    toast("Dados atualizados.");
    await load();
  } catch (err) { $("personal-error").textContent = err.message; }
  finally { btn.disabled = false; }
});

$("plan-select").addEventListener("change", async e => {
  const sel = e.currentTarget, code = sel.value; sel.disabled = true; $("plan-error").textContent = "";
  try {
    await api("PATCH", "/plan", { plan_code: code });
    toast("Plano atualizado.");
  } catch (err) { $("plan-error").textContent = err.message; }
  finally { sel.disabled = false; await load(); }
});

$("skill-form").addEventListener("submit", async e => {
  e.preventDefault();
  const id = $("s-skill").value; $("skill-error").textContent = "";
  if (!id) { $("skill-error").textContent = "Selecione uma habilidade."; $("s-skill").focus(); return; }
  const btn = $("skill-add"); btn.disabled = true;
  try {
    await api("POST", "/skills", { skill_id: Number(id), nivel: $("s-nivel").value });
    toast("Habilidade adicionada.");
    $("s-skill").value = "";
    await load();
  } catch (err) { $("skill-error").textContent = err.message; }
  finally { btn.disabled = false; }
});

$("skills-list").addEventListener("click", async e => {
  const btn = e.target.closest("button[data-skill]");
  if (!btn) return;
  btn.disabled = true; $("skill-error").textContent = "";
  try {
    await api("DELETE", `/skills/${btn.dataset.skill}`);
    toast("Declaração removida.");
    await load();
  } catch (err) { $("skill-error").textContent = err.message; btn.disabled = false; }
});

async function loadCatalog() {
  try {
    const res = await fetch("/api/admin/skills");
    if (!res.ok) return;
    const skills = await res.json();
    $("s-skill").insertAdjacentHTML("beforeend", skills.map(s => `<option value="${Number(s.id)}">${escapeHtml(s.name)}</option>`).join(""));
  } catch { /* o seletor fica só com o placeholder */ }
}

(async function init() {
  try {
    await Promise.all([load(), loadCatalog()]);
    $("loading").hidden = true;
    $("content").hidden = false;
    AdminExcluirConta.init({ url: `/api/admin/users/${USER_ID}`, nome: fullName(dev), voltar: "/admin/usuarios" });
  } catch (err) {
    console.error(err);
    $("loading").innerHTML = `
      <div role="alert">
        <p class="adm-error">Erro ao carregar o perfil.</p>
        <a class="adm-error-link" href="/admin/usuarios">← Voltar para a lista</a>
      </div>`;
  }
})();
</script>

</body>
</html>
