<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/webp" href="/img/principal-gradiente.webp" />
  <meta name="description" content="Relatório de desempenho das vagas — Ápice." />
  <title>Ápice — Admin · <%= categoria.titulo %></title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/design-system.css" />
  <link rel="stylesheet" href="/css/header.css" />
  <link rel="stylesheet" href="/css/admin-dashboard.css" />
  <link rel="stylesheet" href="/css/admin-vagas.css" />
  <link rel="stylesheet" href="/css/admin-relatorios.css" />
  <link rel="stylesheet" href="/css/admin-crescimento.css" />
  <link rel="stylesheet" href="/css/admin-desempenho.css" />
</head>
<body>

  <%- include('partials/header-admin', { currentPage: 'admin-relatorios' }) %>

<main class="adm-main" id="main-content">
  <div class="adc-wrap">

    <a href="/admin/relatorios" class="adr-back">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      Voltar
    </a>

    <header class="adr-head">
      <h1 class="adr-title"><%= categoria.titulo %></h1>
      <p class="adr-sub"><%= categoria.descricao %></p>
    </header>

    <section class="adm-loading" id="loading" role="status" aria-live="polite">
      <span class="adm-spinner" aria-hidden="true"></span>
      <p>Carregando relatório...</p>
    </section>

    <div id="content" hidden>

      <%# ── Indicadores ── %>
      <section aria-labelledby="h-kpis">
        <h2 class="visually-hidden" id="h-kpis">Indicadores</h2>
        <ul class="adc-kpis">
          <li class="adc-card">
            <p class="adc-kpi-title">Total de vagas ativas</p>
            <p class="adc-kpi-row"><strong class="adc-kpi-value" id="k-vagas"></strong><span class="adc-badge" id="k-vagas-badge"></span></p>
            <span class="adc-split" aria-hidden="true"><span id="k-vagas-bar"></span></span>
            <p class="adc-kpi-sub" id="k-vagas-sub"></p>
          </li>
          <li class="adc-card">
            <p class="adc-kpi-title">Média de candidatos por vaga</p>
            <p class="adc-kpi-row"><strong class="adc-kpi-value" id="k-cand"></strong><span class="adc-badge" id="k-cand-badge"></span></p>
            <p class="adc-kpi-sub" id="k-cand-sub"></p>
          </li>
          <li class="adc-card">
            <p class="adc-kpi-title">Taxa de match por vaga</p>
            <p class="adc-kpi-row"><strong class="adc-kpi-value" id="k-match"></strong><span class="adc-badge" id="k-match-badge"></span></p>
            <p class="adc-kpi-sub">Matchs aceitos sobre candidaturas no período</p>
          </li>
          <li class="adc-card">
            <p class="adc-kpi-title">Tempo médio de fechamento</p>
            <p class="adc-kpi-row"><strong class="adc-kpi-value" id="k-tempo"></strong></p>
            <p class="adc-kpi-sub" id="k-tempo-sub"></p>
          </li>
        </ul>
      </section>

      <%# ── Volume e conversão por stacks ── %>
      <section class="adc-section" aria-labelledby="h-vol" aria-busy="false" id="evo">
        <div class="adc-evo-head">
          <h2 class="adc-h2" id="h-vol">Volume e conversão por stacks</h2>
          <fieldset class="adv-group adc-seg" id="seg" aria-label="Período do relatório">
            <button type="button" class="adv-chip" data-p="7"      aria-pressed="false">7 dias</button>
            <button type="button" class="adv-chip" data-p="30"     aria-pressed="true">30 dias</button>
            <button type="button" class="adv-chip" data-p="90"     aria-pressed="false">90 dias</button>
            <button type="button" class="adv-chip" data-p="custom" aria-pressed="false">Personalizado</button>
          </fieldset>
        </div>

        <form class="adc-range" id="range-form" hidden novalidate>
          <div class="adv-field"><label for="r-from">De</label><input type="date" id="r-from" required /></div>
          <div class="adv-field"><label for="r-to">Até</label><input type="date" id="r-to" required /></div>
          <button type="submit" class="adv-btn adv-btn--primary">Aplicar</button>
          <p class="adv-form-error" id="range-error" role="alert"></p>
        </form>

        <figure class="adc-card adc-chart">
          <figcaption class="adc-chart-head">
            <h3 class="adc-h3">Vagas vs Candidaturas por Stack</h3>
            <button type="button" class="adc-tbl-btn" data-target="stacks" aria-pressed="false">Ver como tabela</button>
          </figcaption>
          <ul class="adc-legend" aria-label="Legenda">
            <li><span class="adc-sw" style="background:#8B5CF6"></span>Vagas ativas</li>
            <li><span class="adc-sw" style="background:#0FA391"></span>Candidaturas</li>
          </ul>
          <div class="adc-plot" id="plot-stacks" role="group" aria-label="Gráfico de barras: vagas ativas e candidaturas no período por stack"></div>
          <div class="adc-table-wrap" id="table-stacks" hidden></div>
          <p class="adc-note">Vagas ativas é o retrato de hoje; candidaturas contam o período escolhido.</p>
        </figure>

        <section class="adc-card" aria-labelledby="h-fill">
          <h3 class="adc-h3" id="h-fill">Taxa de preenchimento por nível</h3>
          <ul class="add-fill" id="fill-list"></ul>
          <p class="adc-note">Vaga preenchida = vaga ativa com ao menos um match aceito pela empresa.</p>
        </section>
      </section>

      <%# ── Ranking de vagas ── %>
      <section class="adc-section" aria-labelledby="h-rank">
        <div class="adc-evo-head">
          <h2 class="adc-h2" id="h-rank">Ranking de vagas</h2>
          <p class="add-period" id="rank-period"></p>
        </div>
        <section class="adc-card add-rank" aria-labelledby="h-eng">
          <h3 class="adc-h3" id="h-eng">Vagas com maior engajamento</h3>
          <div class="adc-table-wrap">
            <table class="adr-table add-table">
              <caption class="visually-hidden">Vagas com mais candidaturas e matchs no período</caption>
              <thead>
                <tr>
                  <th scope="col">Título</th>
                  <th scope="col">Empresa</th>
                  <th scope="col" class="num">Candidatos</th>
                  <th scope="col" class="num">Matchs</th>
                  <th scope="col" class="num">Ações</th>
                </tr>
              </thead>
              <tbody id="rank-tbody"></tbody>
            </table>
          </div>
          <p class="adm-empty" id="rank-empty" hidden>Nenhuma candidatura ou match no período.</p>
        </section>
      </section>

      <%- include('partials/admin-gerar-relatorio', { comTipo: false }) %>

    </div>
  </div>
</main>

<output class="adv-toast" id="toast" role="status" aria-live="polite"></output>

<footer class="adm-footer">
  <p>&copy; <%= new Date().getFullYear() %> Ápice. Painel do administrador.</p>
</footer>

<script src="/js/escape-html.js"></script>
<script src="/js/admin-relatorio.js"></script>
<script>
const $ = (id) => document.getElementById(id);
const API = "/api/admin/reports/desempenho-das-vagas";
const { COR, fmt, fmt1, hojeIso, diasAtras, qs, el, scaleFor, frame, topRound, tooltip } = AR;

const page = { p: "30", from: diasAtras(29), to: hojeIso() };
const dataBr = (iso) => `${iso.slice(8, 10)}/${iso.slice(5, 7)}/${iso.slice(0, 4)}`;

// ── Gráfico de barras agrupadas: vagas × candidaturas por stack ──
function renderStacks(data) {
  const plot = $("plot-stacks");
  plot.querySelectorAll("svg").forEach(n => n.remove());
  const W = 960, H = 290, m = { l: 48, r: 20, t: 16, b: 32 };
  const n = data.length, iw = W - m.l - m.r, gw = iw / n;
  const xAt = (i) => m.l + gw * i + gw / 2;
  const maxV = Math.max(...data.map(d => Math.max(d.vagas, d.candidaturas)), 0);
  const { svg, y } = frame(W, H, m, scaleFor(maxV), data.map(d => d.label), xAt);
  const base = y(0), barW = Math.max(8, Math.min(40, gw * 0.22)), gap = 6;

  data.forEach((d, i) => {
    [[d.vagas, COR.devs, xAt(i) - barW - gap / 2], [d.candidaturas, COR.empresas, xAt(i) + gap / 2]].forEach(([v, cor, x]) => {
      if (v > 0) svg.appendChild(el("path", { d: topRound(x, y(v), barW, base - y(v), 4), fill: cor }));
    });
  });

  const tip = tooltip(plot);
  data.forEach((d, i) => {
    const hit = el("rect", { x: m.l + gw * i, y: m.t, width: gw, height: H - m.t - m.b, fill: "transparent" });
    hit.addEventListener("mouseenter", () => tip.show((xAt(i) / W) * 100, d.label, [[COR.devs, "Vagas ativas", d.vagas], [COR.empresas, "Candidaturas", d.candidaturas]]));
    hit.addEventListener("mouseleave", () => tip.hide());
    svg.appendChild(hit);
  });
  plot.prepend(svg);
}

function tableHtml(caption, head, rows) {
  return `<table class="adr-table"><caption class="visually-hidden">${escapeHtml(caption)}</caption>
    <thead><tr>${head.map((h, i) => `<th scope="col"${i ? ' class="num"' : ""}>${escapeHtml(h)}</th>`).join("")}</tr></thead>
    <tbody>${rows.map(r => `<tr>${r.map((c, i) => i ? `<td class="num">${typeof c === "number" ? fmt(c) : escapeHtml(c)}</td>` : `<th scope="row">${escapeHtml(c)}</th>`).join("")}</tr>`).join("")}</tbody></table>`;
}

function badge(node, valor, sufixo, rotulo) {
  node.className = "adc-badge";
  if (valor == null) { node.textContent = "—"; node.title = "Sem base de comparação no período"; return; }
  node.classList.add(valor > 0 ? "is-up" : valor < 0 ? "is-down" : "is-flat");
  const num = Number.isInteger(valor) ? String(Math.abs(valor)) : fmt1(Math.abs(valor));
  node.textContent = `${valor > 0 ? "+" : valor < 0 ? "−" : ""}${num}${sufixo}`;
  node.title = rotulo;
}

function renderKpis(k) {
  $("k-vagas").textContent = fmt(k.vagas_ativas.total);
  badge($("k-vagas-badge"), k.vagas_ativas.variacao_pct, "%", "Variação do total de vagas cadastradas no período");
  $("k-vagas-bar").style.width = `${k.vagas_ativas.total ? (k.vagas_ativas.preenchidas / k.vagas_ativas.total) * 100 : 0}%`;
  $("k-vagas-sub").textContent = `${fmt(k.vagas_ativas.preenchidas)} preenchidas / ${fmt(k.vagas_ativas.abertas)} abertas`;
  $("k-cand").textContent = fmt1(k.candidatos_por_vaga.media);
  badge($("k-cand-badge"), k.candidatos_por_vaga.variacao_pct, "%", "Variação das candidaturas em relação ao período anterior");
  $("k-cand-sub").textContent = `${fmt(k.candidatos_por_vaga.total)} candidaturas no período`;
  $("k-match").textContent = k.taxa_match.taxa == null ? "—" : `${fmt1(k.taxa_match.taxa)}%`;
  badge($("k-match-badge"), k.taxa_match.variacao_pp, " p.p.", "Variação da taxa de match em relação ao período anterior, em pontos percentuais");
  $("k-tempo").textContent = k.tempo_fechamento.dias == null ? "—" : `${fmt1(k.tempo_fechamento.dias)} dias`;
  $("k-tempo-sub").textContent = k.tempo_fechamento.amostra
    ? `${fmt(k.tempo_fechamento.amostra)} vaga(s) fechada(s) no período`
    : "Nenhuma vaga fechada no período";
}

function renderFill(rows) {
  $("fill-list").innerHTML = rows.map(r => `
    <li class="add-fill-row">
      <span class="add-fill-label">${escapeHtml(r.label)} <span class="add-fill-pct">${r.taxa == null ? "sem vagas" : `(${r.taxa}%)`}</span></span>
      <span class="add-fill-track" aria-hidden="true"><span class="add-fill-bar" style="width:${r.taxa ?? 0}%"></span></span>
      <span class="add-fill-count">${fmt(r.preenchidas)} de ${fmt(r.total)}</span>
    </li>`).join("");
}

function renderRanking(rows) {
  $("rank-empty").hidden = rows.length > 0;
  $("rank-tbody").innerHTML = rows.map(v => `
    <tr>
      <th scope="row" class="add-title">${escapeHtml(v.title)}</th>
      <td class="add-company">${escapeHtml(v.company || "—")}</td>
      <td class="num">${fmt(v.candidatos)}</td>
      <td class="num">${fmt(v.matchs)}</td>
      <td class="num"><a class="adv-icon-btn" href="/admin/vagas/${Number(v.id)}" aria-label="Ver vaga ${escapeHtml(v.title)}">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
      </a></td>
    </tr>`).join("");
}

function renderAll(r) {
  renderKpis(r.kpis);
  renderStacks(r.stacks);
  $("table-stacks").innerHTML = tableHtml("Vagas ativas e candidaturas por stack", ["Stack", "Vagas ativas", "Candidaturas"], r.stacks.map(s => [s.label, s.vagas, s.candidaturas]));
  renderFill(r.preenchimento);
  renderRanking(r.ranking);
  $("rank-period").textContent = `Período: ${dataBr(r.periodo.from)} a ${dataBr(r.periodo.to)}`;
}

async function fetchReport(sel) {
  const res = await fetch(`${API}?${qs(sel)}`);
  const data = await res.json().catch(() => ({}));
  if (!res.ok) throw new Error(data.error || "Erro ao carregar o relatório.");
  return data;
}

let toastTimer;
function toast(msg, isErr = false) {
  const t = $("toast"); t.textContent = msg; t.classList.toggle("is-error", isErr); t.classList.add("show");
  clearTimeout(toastTimer); toastTimer = setTimeout(() => t.classList.remove("show"), 2800);
}

// ── Período ──
async function aplicarPagina() {
  const evo = $("evo"); evo.setAttribute("aria-busy", "true");
  try { renderAll(await fetchReport(page)); }
  catch (err) { toast(err.message, true); }
  finally { evo.setAttribute("aria-busy", "false"); }
}
$("seg").querySelectorAll("[data-p]").forEach(btn => btn.addEventListener("click", () => {
  page.p = btn.dataset.p;
  $("seg").querySelectorAll("[data-p]").forEach(b => b.setAttribute("aria-pressed", String(b === btn)));
  $("range-form").hidden = page.p !== "custom";
  if (page.p === "custom") { $("r-from").value = page.from; $("r-to").value = page.to; $("r-from").focus(); return; }
  aplicarPagina();
}));
$("range-form").addEventListener("submit", async e => {
  e.preventDefault();
  const from = $("r-from").value, to = $("r-to").value;
  $("range-error").textContent = "";
  if (!from || !to) { $("range-error").textContent = "Informe as duas datas."; return; }
  page.from = from; page.to = to;
  try { renderAll(await fetchReport(page)); } catch (err) { $("range-error").textContent = err.message; }
});
$("r-to").max = hojeIso();

document.querySelectorAll(".adc-tbl-btn").forEach(btn => btn.addEventListener("click", () => {
  const alvo = btn.dataset.target, ativo = btn.getAttribute("aria-pressed") !== "true";
  btn.setAttribute("aria-pressed", String(ativo));
  btn.textContent = ativo ? "Ver gráfico" : "Ver como tabela";
  $(`plot-${alvo}`).hidden = ativo; $(`table-${alvo}`).hidden = !ativo;
}));

// ── Gerar relatório (pop-up) ──
AR.initGerar({ api: API, comTipo: false, toast });

(async function init() {
  try {
    const r = await fetchReport(page);
    $("loading").hidden = true; $("content").hidden = false;
    renderAll(r);
  } catch (err) {
    console.error(err);
    $("loading").innerHTML = `
      <div role="alert">
        <p class="adm-error">Erro ao carregar o relatório.</p>
        <a class="adm-error-link" href="/admin/relatorios">← Voltar às categorias</a>
      </div>`;
  }
})();
</script>

</body>
</html>
