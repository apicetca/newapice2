<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/webp" href="/img/principal-gradiente.webp" />
  <meta name="description" content="Categorias de vagas e opções disponíveis — painel do administrador." />
  <title>Ápice — Admin · Categorias e vagas</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/design-system.css" />
  <link rel="stylesheet" href="/css/header.css" />
  <link rel="stylesheet" href="/css/admin-dashboard.css" />
  <link rel="stylesheet" href="/css/admin-vagas.css" />
  <link rel="stylesheet" href="/css/admin-relatorios.css" />
  <link rel="stylesheet" href="/css/admin-categorias.css" />
</head>
<body>

  <%- include('partials/header-admin', { currentPage: 'admin-configuracoes' }) %>

<main class="adm-main" id="main-content">
  <div class="adk-wrap">

    <a href="/admin/configuracoes" class="adr-back">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      Voltar
    </a>

    <header class="adk-head">
      <div>
        <h1 class="adr-title">Categorias e vagas</h1>
        <p class="adk-sub">Organize as categorias de vagas e gerencie as opções disponíveis</p>
      </div>
      <button type="button" class="adk-primary" id="new-btn" aria-haspopup="dialog">+ Nova categoria</button>
    </header>

    <section class="adm-loading" id="loading" role="status" aria-live="polite">
      <span class="adm-spinner" aria-hidden="true"></span>
      <p>Carregando...</p>
    </section>

    <section class="adk-card" id="content" hidden aria-label="Categorias e opções de vaga">
      <div class="adk-tabs" role="tablist" aria-label="Tipo de opção">
        <button type="button" role="tab" class="adk-tab" id="tab-categorias" data-tab="categorias" aria-selected="true"  aria-controls="panel" tabindex="0">Categorias</button>
        <button type="button" role="tab" class="adk-tab" id="tab-modalidades" data-tab="modalidades" aria-selected="false" aria-controls="panel" tabindex="-1">Modalidades</button>
        <button type="button" role="tab" class="adk-tab" id="tab-niveis" data-tab="niveis" aria-selected="false" aria-controls="panel" tabindex="-1">Nível de experiência</button>
        <button type="button" role="tab" class="adk-tab" id="tab-contratacao" data-tab="contratacao" aria-selected="false" aria-controls="panel" tabindex="-1">Contratação</button>
        <button type="button" role="tab" class="adk-tab" id="tab-habilidades" data-tab="habilidades" aria-selected="false" aria-controls="panel" tabindex="-1">Habilidades</button>
      </div>

      <div class="adk-panel" id="panel" role="tabpanel" aria-labelledby="tab-categorias" tabindex="0">
        <div class="adk-cols" id="cols">
          <section class="adk-list-card" aria-labelledby="list-title">
            <h2 class="adk-list-title" id="list-title"></h2>
            <ul class="adk-list" id="list"></ul>
          </section>
          <article class="adk-detail" id="detail" aria-live="polite"></article>
        </div>

        <section class="adk-detail adk-skills" id="skills-panel" hidden aria-labelledby="skills-title">
          <h2 class="adk-name" id="skills-title">Catálogo de habilidades</h2>
          <p class="adk-desc" id="skills-desc"></p>
          <div class="adk-actions"><a class="adk-btn" href="/admin/configuracoes/categorias-e-vagas/habilidades">Gerenciar habilidades</a></div>
        </section>
      </div>
    </section>

  </div>
</main>

<%# ── Nova / editar categoria ── %>
<dialog class="adv-dialog adk-dialog" id="cat-dialog" aria-labelledby="cat-title">
  <header class="adv-dialog-head">
    <h2 class="adv-dialog-title" id="cat-title">Nova categoria</h2>
    <button type="button" class="adv-dialog-close" id="cat-close" aria-label="Fechar">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
  </header>
  <form id="cat-form" novalidate>
    <div class="adv-field">
      <label for="c-nome">Nome</label>
      <input type="text" id="c-nome" maxlength="60" required autocomplete="off" placeholder="Ex.: UX/UI" />
    </div>
    <div class="adv-field adk-field-gap">
      <label for="c-desc">Descrição</label>
      <textarea id="c-desc" class="adk-textarea" rows="4" maxlength="255"></textarea>
    </div>
    <p class="adv-form-error" id="cat-error" role="alert"></p>
    <div class="adk-foot">
      <button type="submit" class="adk-primary" id="cat-save">Publicar</button>
      <button type="button" class="adk-btn" id="cat-cancel">Cancelar</button>
    </div>
  </form>
</dialog>

<output class="adv-toast" id="toast" role="status" aria-live="polite"></output>

<footer class="adm-footer">
  <p>&copy; <%= new Date().getFullYear() %> Ápice. Painel do administrador.</p>
</footer>

<script src="/js/escape-html.js"></script>
<script>
const $ = (id) => document.getElementById(id);
const nf = new Intl.NumberFormat("pt-BR");
const compacto = (n) => (n >= 1000 ? `${(n / 1000).toFixed(1).replace(/\.0$/, "")}K` : String(n));

const TABS = {
  categorias:  { titulo: "Categorias", fixa: false },
  modalidades: { titulo: "Modalidades", fixa: true, chave: "modalidades", rotuloVagas: "Vagas com esta modalidade" },
  niveis:      { titulo: "Níveis de experiência", fixa: true, chave: "niveis", rotuloVagas: "Vagas neste nível" },
  contratacao: { titulo: "Tipos de contratação", fixa: true, chave: "contratacao", rotuloVagas: "Vagas com esta contratação" },
  habilidades: { titulo: "Habilidades" },
};
const state = { tab: "categorias", categorias: [], opcoes: null, sel: {} };

function itensDaAba() {
  if (state.tab === "categorias") return state.categorias.map(c => ({ id: c.id, nome: c.nome, descricao: c.descricao, vagas: c.vagas, active: c.active }));
  return state.opcoes[TABS[state.tab].chave].map(o => ({ id: o.valor, nome: o.nome, descricao: o.descricao, vagas: o.vagas, active: true }));
}

let toastTimer;
function toast(msg, isErr = false) {
  const t = $("toast"); t.textContent = msg; t.classList.toggle("is-error", isErr); t.classList.add("show");
  clearTimeout(toastTimer); toastTimer = setTimeout(() => t.classList.remove("show"), 2800);
}
async function api(method, path, body) {
  const res = await fetch(`/api/admin/${path}`, { method, headers: { "Content-Type": "application/json" }, body: body ? JSON.stringify(body) : undefined });
  const data = await res.json().catch(() => ({}));
  if (!res.ok) throw new Error(data.error || "Erro ao salvar. Tente novamente.");
  return data;
}

const ICON_EDIT = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>';

function render() {
  const aba = TABS[state.tab], ehHab = state.tab === "habilidades", ehCat = state.tab === "categorias";
  $("panel").setAttribute("aria-labelledby", `tab-${state.tab}`);
  $("new-btn").hidden = !ehCat;
  $("cols").hidden = ehHab; $("skills-panel").hidden = !ehHab;
  document.querySelectorAll(".adk-tab").forEach(t => {
    const on = t.dataset.tab === state.tab;
    t.setAttribute("aria-selected", String(on)); t.tabIndex = on ? 0 : -1;
  });
  if (ehHab) {
    const h = state.opcoes.habilidades;
    $("skills-desc").textContent = `${nf.format(h.total)} habilidades no catálogo (${nf.format(h.tecnicas)} técnicas e ${nf.format(h.comportamentais)} comportamentais). Elas definem as skills que as vagas exigem e que os devs declaram.`;
    return;
  }

  const itens = itensDaAba();
  const selId = itens.some(i => i.id === state.sel[state.tab]) ? state.sel[state.tab] : itens[0]?.id;
  state.sel[state.tab] = selId;
  $("list-title").innerHTML = `${escapeHtml(aba.titulo)} <span class="adk-count">(${itens.length})</span>`;

  $("list").innerHTML = itens.length ? itens.map(i => `
    <li class="adk-item${i.id === selId ? " is-selected" : ""}${i.active ? "" : " is-off"}">
      <button type="button" class="adk-item-btn" data-id="${escapeHtml(String(i.id))}" aria-current="${i.id === selId}">
        <span class="adk-item-name">${escapeHtml(i.nome)}${i.active ? "" : ' <span class="adk-off">inativa</span>'}</span>
        <span class="adk-item-count" title="${nf.format(i.vagas)} vagas">${compacto(i.vagas)}</span>
      </button>
      ${ehCat ? `<span class="adk-kebab-wrap">
        <button type="button" class="adk-kebab" data-menu="${i.id}" aria-haspopup="menu" aria-expanded="false" aria-label="Ações de ${escapeHtml(i.nome)}">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="5" r="1.8"/><circle cx="12" cy="12" r="1.8"/><circle cx="12" cy="19" r="1.8"/></svg>
        </button>
        <ul class="adk-menu" role="menu" hidden>
          <li role="none"><button type="button" role="menuitem" data-act="edit" data-id="${i.id}">Editar</button></li>
          <li role="none"><button type="button" role="menuitem" data-act="toggle" data-id="${i.id}">${i.active ? "Desativar" : "Ativar"}</button></li>
        </ul></span>` : ""}
    </li>`).join("") : '<li class="adk-empty">Nenhuma categoria cadastrada ainda.</li>';

  const cur = itens.find(i => i.id === selId);
  if (!cur) { $("detail").innerHTML = '<p class="adk-desc">Crie a primeira categoria em "+ Nova categoria".</p>'; return; }
  $("detail").innerHTML = `
    <div class="adk-detail-head">
      <h2 class="adk-name">${escapeHtml(cur.nome)}</h2>
      ${ehCat ? `<span class="adk-badge ${cur.active ? "is-on" : "is-off"}">${cur.active ? "Ativo" : "Inativo"}</span>` : ""}
    </div>
    <p class="adk-desc">${cur.descricao ? escapeHtml(cur.descricao) : "Sem descrição."}</p>
    <div class="adk-stat">
      <p class="adk-stat-label">${escapeHtml(ehCat ? "Vagas que utilizam esta categoria:" : aba.rotuloVagas + ":")}</p>
      <p class="adk-stat-value">${nf.format(cur.vagas)}</p>
    </div>
    ${ehCat ? `<div class="adk-actions">
      <button type="button" class="adk-btn" data-act="edit" data-id="${cur.id}">${ICON_EDIT} Editar</button>
      <button type="button" class="adk-primary adk-primary--sm" data-act="toggle" data-id="${cur.id}">${cur.active ? "Desativar" : "Ativar"}</button>
    </div>` : '<p class="adk-fixed">Opção fixa da plataforma: ela vem do cadastro da vaga e não pode ser criada nem editada aqui.</p>'}`;
}

// ── Abas (teclado: setas, Home, End) ──
const abas = () => [...document.querySelectorAll(".adk-tab")];
function abrirAba(nome, focar) { state.tab = nome; render(); if (focar) $(`tab-${nome}`).focus(); }
abas().forEach(t => t.addEventListener("click", () => abrirAba(t.dataset.tab, false)));
document.querySelector(".adk-tabs").addEventListener("keydown", e => {
  const lista = abas(), i = lista.findIndex(t => t.dataset.tab === state.tab);
  const alvo = { ArrowRight: (i + 1) % lista.length, ArrowLeft: (i - 1 + lista.length) % lista.length, Home: 0, End: lista.length - 1 }[e.key];
  if (alvo == null) return;
  e.preventDefault(); abrirAba(lista[alvo].dataset.tab, true);
});

// ── Lista, menu ⋮ e ações ──
function fecharMenus(devolverFoco) {
  document.querySelectorAll(".adk-menu:not([hidden])").forEach(m => {
    m.hidden = true;
    const b = m.previousElementSibling; b.setAttribute("aria-expanded", "false"); if (devolverFoco) b.focus();
  });
}
document.addEventListener("click", e => { if (!e.target.closest(".adk-kebab-wrap")) fecharMenus(false); });
document.addEventListener("keydown", e => { if (e.key === "Escape") fecharMenus(true); });

$("panel").addEventListener("click", async e => {
  const item = e.target.closest(".adk-item-btn");
  if (item) { state.sel[state.tab] = state.tab === "categorias" ? Number(item.dataset.id) : item.dataset.id; render(); return; }
  const kebab = e.target.closest(".adk-kebab");
  if (kebab) {
    const menu = kebab.nextElementSibling, abrir = menu.hidden;
    fecharMenus(false);
    menu.hidden = !abrir; kebab.setAttribute("aria-expanded", String(abrir));
    if (abrir) menu.querySelector("button").focus();
    return;
  }
  const act = e.target.closest("[data-act]");
  if (!act) return;
  fecharMenus(false);
  const cat = state.categorias.find(c => c.id === Number(act.dataset.id));
  if (!cat) return;
  state.sel.categorias = cat.id;
  if (act.dataset.act === "edit") return abrirDialogo(cat);
  act.disabled = true;
  try {
    await api("PATCH", `job-categories/${cat.id}`, { active: !cat.active });
    toast(cat.active ? "Categoria desativada." : "Categoria ativada.");
    await carregar();
  } catch (err) { toast(err.message, true); act.disabled = false; }
});

// ── Nova / editar ──
const dlg = $("cat-dialog");
let editando = null;
function abrirDialogo(cat) {
  editando = cat ?? null;
  $("cat-title").textContent = cat ? "Editar categoria" : "Nova categoria";
  $("cat-save").textContent = cat ? "Salvar" : "Publicar";
  $("c-nome").value = cat?.nome ?? ""; $("c-desc").value = cat?.descricao ?? "";
  $("cat-error").textContent = "";
  dlg.showModal(); $("c-nome").focus();
}
$("new-btn").addEventListener("click", () => abrirDialogo(null));
$("cat-close").addEventListener("click", () => dlg.close());
$("cat-cancel").addEventListener("click", () => dlg.close());
dlg.addEventListener("click", e => { if (e.target === dlg) dlg.close(); });
$("cat-form").addEventListener("submit", async e => {
  e.preventDefault();
  const btn = $("cat-save"); btn.disabled = true; $("cat-error").textContent = "";
  const corpo = { nome: $("c-nome").value, descricao: $("c-desc").value };
  try {
    if (editando) await api("PATCH", `job-categories/${editando.id}`, corpo);
    else { const r = await api("POST", "job-categories", corpo); state.sel.categorias = r.id; }
    dlg.close();
    toast(editando ? "Categoria atualizada." : "Categoria publicada.");
    await carregar();
  } catch (err) { $("cat-error").textContent = err.message; }
  finally { btn.disabled = false; }
});
dlg.addEventListener("close", () => { (editando ? document.querySelector(`.adk-item-btn[data-id="${editando.id}"]`) : $("new-btn"))?.focus?.(); });

async function carregar() {
  const [c, o] = await Promise.all([fetch("/api/admin/job-categories"), fetch("/api/admin/job-options")]);
  if (!c.ok || !o.ok) throw new Error("Falha ao carregar");
  state.categorias = await c.json(); state.opcoes = await o.json();
  render();
}

(async function init() {
  try { await carregar(); $("loading").hidden = true; $("content").hidden = false; }
  catch (err) {
    console.error(err);
    $("loading").innerHTML = '<div role="alert"><p class="adm-error">Erro ao carregar as categorias.</p><a class="adm-error-link" href="/admin/configuracoes">← Voltar às configurações</a></div>';
  }
})();
</script>

</body>
</html>
