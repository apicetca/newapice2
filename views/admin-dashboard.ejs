<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/webp" href="/img/principal-gradiente.webp" />
  <meta name="description" content="Painel do administrador — Ápice." />
  <title>Ápice — Painel Admin</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/design-system.css" />
  <link rel="stylesheet" href="/css/header.css" />
  <link rel="stylesheet" href="/css/admin-dashboard.css" />
</head>
<body>

  <%- include('partials/header-admin', { currentPage: 'admin-dashboard' }) %>

<%
  const ic = {
    devs:    '<path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>',
    empresa: '<rect x="3" y="7" width="18" height="14" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>',
    vagas:   '<rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/>',
    pro:     '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>',
    matchs:  '<circle cx="12" cy="12" r="9"/><path d="m8 12.5 2.8 2.8L16 9.5"/>',
    mentor:  '<rect x="5" y="8" width="14" height="12" rx="3"/><path d="M12 8V4M9 13h.01M15 13h.01M9.5 17h5"/>'
  };
  const cards = [
    { id: 'devs',     href: '/admin/usuarios',   icon: 'devs',    title: 'Desenvolvedores', sub: '— devs novos' },
    { id: 'empresas', href: '/admin/empresas',   icon: 'empresa', title: 'Empresas',        sub: '— empresas novas' },
    { id: 'vagas',    href: '/admin/vagas',      icon: 'vagas',   title: 'Vagas Ativas',    sub: '— vagas ativas' },
    { id: 'pro',      href: '/admin/usuarios',   icon: 'pro',     title: 'Assinantes PRO',  sub: '— usuários PRO' },
    { id: 'matchs',   href: '/admin/relatorios/compatibilidade-de-matchs', icon: 'matchs',  title: 'Matchs aceitos',  sub: '— matchs aceitos' },
    { id: 'mentor',   href: '/admin/relatorios', icon: 'mentor',  title: 'Uso do mentor',   sub: '— análises com IA' }
  ];
%>

<main class="adm-main" id="main-content">
  <h1 class="visually-hidden">Dashboard do administrador</h1>

  <section class="adm-loading" id="loading" role="status" aria-live="polite">
    <span class="adm-spinner" aria-hidden="true"></span>
    <p>Carregando painel...</p>
  </section>

  <div class="adm-layout" id="content" hidden>

    <div class="adm-col">

      <section aria-label="Métricas da plataforma">
        <ul class="adm-stats">
          <% cards.forEach(c => { %>
          <li>
            <a class="adm-stat" href="<%= c.href %>">
              <span class="adm-stat-ico" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><%- ic[c.icon] %></svg>
              </span>
              <span class="adm-stat-txt">
                <span class="adm-stat-title"><%= c.title %></span>
                <span class="adm-stat-sub" id="m-<%= c.id %>"><%= c.sub %></span>
              </span>
              <svg class="adm-chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
            </a>
          </li>
          <% }) %>
        </ul>
      </section>

      <section aria-labelledby="devs-heading">
        <h2 class="adm-heading" id="devs-heading">Desenvolvedores recentes</h2>
        <figure class="adm-panel">
          <div class="adm-table-wrap">
            <table class="adm-table">
              <caption class="visually-hidden">Desenvolvedores cadastrados mais recentemente</caption>
              <thead>
                <tr>
                  <th scope="col">Nome</th>
                  <th scope="col">E-mail</th>
                  <th scope="col">Nível</th>
                  <th scope="col">Cadastro</th>
                </tr>
              </thead>
              <tbody id="devs-recentes-tbody"></tbody>
            </table>
          </div>
          <p class="adm-empty" id="devs-recentes-empty" hidden>Nenhum desenvolvedor cadastrado ainda</p>
        </figure>
      </section>

    </div>

    <aside class="adm-panel adm-aside" aria-labelledby="empresas-heading">
      <h2 class="adm-heading" id="empresas-heading">Empresas recentes</h2>
      <ul class="adm-companies" id="empresas-recentes-list"></ul>
      <p class="adm-empty" id="empresas-recentes-empty" hidden>Nenhuma empresa cadastrada ainda</p>
    </aside>

  </div>
</main>

<footer class="adm-footer">
  <p>&copy; <%= new Date().getFullYear() %> Ápice. Painel do administrador.</p>
</footer>

<script src="/js/escape-html.js"></script>
<script>
const NIVEIS = { iniciante: "Iniciante", intermediario: "Intermediário", avancado: "Avançado" };
const CORES  = ["#E2E52B", "#59E435", "#60a5fa", "#c084fc", "#f87171", "#fbbf24"];

function formatDate(raw) {
  if (!raw) return "—";
  return new Date(raw).toLocaleDateString("pt-BR");
}

function initials(name) {
  return String(name || "?").trim().split(/\s+/).slice(0, 2).map(w => w.charAt(0)).join("").toUpperCase() || "?";
}

function safeUrl(url) {
  const u = String(url || "");
  return /^https?:\/\//i.test(u) || (u.startsWith("/") && !u.startsWith("//")) ? u : "";
}

function setText(id, text) { document.getElementById(id).textContent = text; }

function renderDevs(rows) {
  const tbody = document.getElementById("devs-recentes-tbody");
  const empty = document.getElementById("devs-recentes-empty");
  tbody.innerHTML = "";
  empty.hidden = rows.length > 0;
  rows.forEach(d => {
    const nome = d.nome ? `${d.nome} ${d.sobrenome ?? ""}`.trim() : "";
    const avatar = safeUrl(d.avatar_url)
      ? `<img class="adm-avatar" src="${escapeHtml(d.avatar_url)}" alt="" width="36" height="36" loading="lazy" />`
      : `<span class="adm-avatar" aria-hidden="true">${escapeHtml(initials(nome || d.email))}</span>`;
    const nivel = NIVEIS[d.nivel] ? `<span class="adm-badge">${NIVEIS[d.nivel]}</span>` : "—";
    const tr = document.createElement("tr");
    tr.innerHTML = `
      <td><span class="adm-person">${avatar}<span>${escapeHtml(nome || "—")}</span></span></td>
      <td>${escapeHtml(d.email)}</td>
      <td>${nivel}</td>
      <td>${formatDate(d.created_at)}</td>`;
    tbody.appendChild(tr);
  });
}

function renderEmpresas(rows) {
  const list  = document.getElementById("empresas-recentes-list");
  const empty = document.getElementById("empresas-recentes-empty");
  list.innerHTML = "";
  empty.hidden = rows.length > 0;
  rows.forEach((e, i) => {
    const nome = e.nome_fantasia ?? e.razao_social ?? "—";
    const n = Number(e.vagasAtivas) || 0;
    const sub = n === 0 ? "Nenhuma vaga ativa" : `${n} ${n === 1 ? "Vaga ativa" : "Vagas ativas"}`;
    const li = document.createElement("li");
    li.innerHTML = `
      <a class="adm-company" href="/admin/empresas">
        <span class="adm-logo" style="background:${CORES[i % CORES.length]}" aria-hidden="true">${escapeHtml(initials(nome))}</span>
        <span class="adm-company-txt">
          <span class="adm-company-name">${escapeHtml(nome)}</span>
          <span class="adm-company-sub">${sub}</span>
        </span>
        <svg class="adm-chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
      </a>`;
    list.appendChild(li);
  });
}

async function init() {
  try {
    const res = await fetch("/api/admin/dashboard");
    if (!res.ok) throw new Error("Falha ao carregar dados");
    const { stats, devsRecentes, empresasRecentes } = await res.json();

    setText("m-devs",     `${stats.novosDevs ?? 0} devs novos`);
    setText("m-empresas", `${stats.novasEmpresas ?? 0} empresas novas`);
    setText("m-vagas",    `${stats.vagasAtivas} ${stats.vagasAtivas === 1 ? "vaga ativa" : "vagas ativas"}`);
    setText("m-pro",      `${stats.assinantesPro ?? 0} usuários PRO`);
    setText("m-matchs",   `${stats.matchsAceitos} matchs aceitos`);
    setText("m-mentor",   `${stats.mentorAnalises ?? 0} análises com IA`);

    renderDevs(devsRecentes);
    renderEmpresas(empresasRecentes);

    document.getElementById("loading").hidden = true;
    document.getElementById("content").hidden = false;
  } catch (err) {
    console.error(err);
    document.getElementById("loading").innerHTML = `
      <div role="alert">
        <p class="adm-error">Erro ao carregar o painel.</p>
        <a class="adm-error-link" href="/">← Voltar à home</a>
      </div>`;
  }
}

init();
</script>

</body>
</html>
