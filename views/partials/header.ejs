      <span>Painel</span>
    </a>

    <a href="/vagas" class="bottom-nav-item" data-path="/vagas">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/><line x1="12" y1="12" x2="12" y2="16"/><line x1="10" y1="14" x2="14" y2="14"/></svg>
      <span>Vagas</span>
    </a>

    <a href="/minhas-vagas" class="bottom-nav-item" data-path="/minhas-vagas">
