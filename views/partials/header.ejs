      <span>Minhas</span>
    </a>

    <a href="/roadmap" class="bottom-nav-item" data-path="/roadmap">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h4l3 10 4-14 3 8 2-4h2"/></svg>
      <span>Roadmap</span>
    </a>

    <a href="/perfil" class="bottom-nav-item" data-path="/perfil">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
      <span>Perfil</span>
    </a>

  <% } else { %>

    <a href="#como-funciona" class="bottom-nav-item">
