      <span>Como funciona</span>
    </a>

    <a href="/vagas" class="bottom-nav-item" data-path="/vagas">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg>
      <span>Vagas</span>
    </a>

    <a href="/login" class="bottom-nav-item" data-path="/login">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
      <span>Entrar</span>
    </a>

    <a href="/cadastro" class="bottom-nav-item bottom-nav-cta" data-path="/cadastro">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="16" y1="11" x2="22" y2="11"/></svg>
      <span>Criar conta</span>
    </a>

  <% } %>
</nav>

<script>
(function () {
  /* Inject favicon (principal(gradiente) primary, principal.webp fallback) */
  (function addFavicon(){
    try{
      var head = document.getElementsByTagName('head')[0] || document.documentElement;
      var link = document.createElement('link');
      link.rel = 'icon';
      link.type = 'image/webp';
      link.href = '/img/principal%28gradiente%29%20%281%29.webp';
      head.appendChild(link);
      var link2 = document.createElement('link');
      link2.rel = 'alternate icon';
      link2.href = '/img/principal.webp';
      head.appendChild(link2);
    }catch(e){/* noop */}
  })();
  /* ── User dropdown ── */
  const dropBtn  = document.getElementById('userMenuBtn');
  const dropList = document.getElementById('userMenuList');
  if (dropBtn && dropList) {
    const closeD = () => { dropBtn.setAttribute('aria-expanded','false'); dropList.hidden = true; };
    const openD  = () => { dropBtn.setAttribute('aria-expanded','true');  dropList.hidden = false; dropList.querySelector('a')?.focus(); };
    dropBtn.addEventListener('click', () => dropBtn.getAttribute('aria-expanded') === 'true' ? closeD() : openD());
    document.addEventListener('click', e => { if (!dropBtn.contains(e.target) && !dropList.contains(e.target)) closeD(); });
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeD(); });
  }

  /* ── Bottom nav: marca item ativo pelo pathname ── */
  const path  = window.location.pathname;
  document.querySelectorAll('.bottom-nav-item[data-path]').forEach(link => {
    if (link.dataset.path === path) {
      link.setAttribute('aria-current', 'page');
      link.classList.add('is-active');
    }
  });
})();
</script>
