<!-- Partial: site header (shared) -->
<header class="site-header">
  <a href="/" class="logo" aria-label="Ápice — início">
    <img src="/img/principal.webp" alt="Ápice" class="site-logo" />
  </a>

  <% if (typeof user !== 'undefined' && user) { %>
    <nav class="header-nav" aria-label="Navegação do usuário">
      <% if (user.avatar) { %>
        <img class="header-avatar" id="header-avatar" src="<%= user.avatar %>" alt="Avatar" />
      <% } %>
      <% if (user.name) { %>
        <span class="header-username">Olá, <strong><%= user.name %></strong></span>
      <% } %>
      <a href="/dashboard" class="nav-btn">Painel</a>
      <a href="/vagas" class="nav-btn">Vagas</a>
      <% if (user.type === 'empresa') { %>
        <a href="/empresa/dashboard" class="nav-btn">Área da empresa</a>
      <% } %>

      <div class="user-menu">
        <button class="user-menu-btn" id="userMenuBtn" aria-haspopup="true" aria-expanded="false" aria-controls="userMenuList">
          <span class="user-menu-label"><%= user.name ? user.name.split(' ')[0] : 'Você' %></span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <ul class="user-menu-list" id="userMenuList" role="menu" hidden>
          <li role="none"><a role="menuitem" href="/perfil">Perfil</a></li>
          <li role="none"><a role="menuitem" href="/minhas-vagas">Minhas vagas</a></li>
          <li role="none"><a role="menuitem" href="/configuracoes">Configurações</a></li>
          <li role="none"><a role="menuitem" href="/auth/logout" class="danger">Sair</a></li>
        </ul>
      </div>
    </nav>
  <% } else { %>
    <nav class="header-nav" aria-label="Navegação principal">
      <a href="#como-funciona">Como funciona</a>
      <a href="#diferenciais">Diferenciais</a>
      <a href="/vagas">Vagas</a>
      <a href="/login" class="nav-link-login">Entrar</a>
      <a href="/cadastro" class="nav-cta">Criar conta grátis</a>
    </nav>
  <% } %>
</header>

<!-- Bottom navigation — visível apenas em mobile -->
