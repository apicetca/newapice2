<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Seu painel no Ápice — vagas, progresso e repositórios." />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" type="image/webp" href="/img/principal-gradiente.webp" />
  <title>Ápice — Dashboard</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/design-system.css" />
  <link rel="stylesheet" href="/css/header.css" />
  <link rel="stylesheet" href="/css/dev.css" />
  <link rel="stylesheet" href="/css/dashboard.css" />
</head>
<body>

  <%- include('partials/header-dev') %>

  <main class="page-content" id="main-content">
    <output class="loading-screen" id="loading" role="status" aria-live="polite">
      <span class="spinner" aria-hidden="true"></span>
      <p>Carregando seu painel...</p>
    </output>

    <div id="content" class="page-wrapper" hidden>
      <div class="dash-layout">

        <div class="dash-main">

          <section class="hero" id="hero"></section>

          <section class="section">
            <h2 class="h2 section-title">Seu resumo</h2>
            <div class="stats">
              <a class="stat" href="/vagas">
                <span class="stat-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                </span>
                <span class="stat-text">
                  <span class="h3 stat-title">Vagas para você</span>
                  <span class="t2 stat-meta" id="stat-jobs-meta">—</span>
                </span>
                <svg class="stat-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
              </a>
              <a class="stat" href="/mensagens">
                <span class="stat-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
                </span>
                <span class="stat-text">
                  <span class="h3 stat-title">Chats abertos</span>
                  <span class="t2 stat-meta" id="stat-chats-meta">—</span>
                </span>
                <svg class="stat-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
              </a>
              <a class="stat" href="/roadmap">
                <span class="stat-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
                </span>
                <span class="stat-text">
                  <span class="h3 stat-title">Roadmap</span>
                  <span class="t2 stat-meta" id="stat-roadmap-meta">—</span>
                </span>
                <svg class="stat-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
              </a>
            </div>
          </section>

          <section class="section">
            <h2 class="h2 section-title">Hoje para você</h2>
            <div class="cards" id="today-cards"></div>
          </section>

        </div>

        <aside class="aside" aria-label="Recomendações">
          <h2 class="h2 aside-title">Recomendações da IA</h2>
          <ol class="recs" id="recs-list"></ol>
        </aside>

      </div>
    </div>
  </main>

  <script id="boot-user" type="application/json"><%- JSON.stringify(user).replace(/<\//g, '<\\/') %></script>
  <script id="boot-jobs" type="application/json"><%- JSON.stringify(jobs || []).replace(/<\//g, '<\\/') %></script>
  <script src="/js/escape-html.js"></script>
  <script>
    // ── Biblioteca de ícones SVG ──────────────────────────
    const IC = {
      pentool:    `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="M2 2l7.586 7.586"/><circle cx="11" cy="11" r="2"/></svg>`,
      settings:   `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>`,
      wrench:     `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>`,
      smartphone: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>`,
      barchart:   `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>`,
      briefcase:  `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>`,
    };

    const capitalize = s => s ? s[0].toUpperCase() + s.slice(1) : "";

    function jobIcon(title) {
      const t = (title || "").toLowerCase();
      if (t.includes("front"))  return IC.pentool;
      if (t.includes("back"))   return IC.settings;
      if (t.includes("full"))   return IC.wrench;
      if (t.includes("mobile")) return IC.smartphone;
      if (t.includes("dados") || t.includes("data")) return IC.barchart;
      return IC.briefcase;
    }

    function goToVaga(jobId) { window.location.href = `/vagas/${jobId}`; }

    // ── Hero ──────────────────────────────────────────────
    function renderHero(user) {
      const hero = document.getElementById("hero");
      const firstName = (user.name ?? user.login ?? user.email ?? "").toString();
      hero.innerHTML = `
        <h1 class="h1">Olá, ${escapeHtml(firstName)}!</h1>
        <p class="t1">Confira suas vagas recomendadas, acompanhe seu progresso e evolua todos os dias.</p>`;
    }

    // ── "Hoje para você" — prévia das vagas mais recentes ──
    const LEVEL_LABEL = { estagio: "Estágio", junior: "Júnior", pleno: "Pleno" };
    const LEVEL_BADGE = { estagio: "badge-green", junior: "badge-blue", pleno: "badge-yellow" };

    function renderTodayCards(jobs) {
      const wrap = document.getElementById("today-cards");
      if (!jobs.length) {
        wrap.innerHTML = `<p class="empty-state" style="grid-column:1/-1">Nenhuma vaga disponível no momento.</p>`;
        return;
      }
      wrap.innerHTML = jobs.slice(0, 2).map(job => `
        <article class="card" tabindex="0" role="button" aria-label="Ver vaga ${escapeHtml(job.title)}" data-job-id="${job.id}">
          <header class="job-card-top">
            <span class="job-icon">${jobIcon(job.title)}</span>
            <hgroup class="job-card-info">
              <h3 class="job-title">${escapeHtml(job.title)}</h3>
              <p class="job-company">${escapeHtml(job.company ?? "Empresa")}</p>
            </hgroup>
            <span class="badge ${LEVEL_BADGE[job.level] ?? "badge-green"}">${LEVEL_LABEL[job.level] ?? job.level}</span>
          </header>
          <p class="card-desc">${escapeHtml((job.description || "").slice(0, 140))}${(job.description || "").length > 140 ? "…" : ""}</p>
          <footer class="job-card-btn">Ver vaga e se candidatar →</footer>
        </article>`).join("");

      wrap.querySelectorAll(".card[data-job-id]").forEach(card => {
        const id = card.dataset.jobId;
        card.addEventListener("click",   () => goToVaga(id));
        card.addEventListener("keydown", e => { if (e.key === "Enter" || e.key === " ") goToVaga(id); });
      });
    }

    // ── Recomendações da IA (heurísticas a partir dos dados já carregados) ──
    function renderRecs(user, jobsCount, roadmaps) {
      const list = document.getElementById("recs-list");
      const recs = [];

      const active = (roadmaps || []).filter(r => Number(r.progress_percent) < 100);
      if (active.length) {
        const next = active[0];
        recs.push({ title: `Continue o roadmap de ${next.title}`, text: `Você já concluiu ${Math.round(next.progress_percent) || 0}% das skills necessárias.` });
      } else {
        recs.push({ title: "Inicie um roadmap", text: "Escolha uma vaga e monte seu plano de estudos personalizado." });
      }

      if (!user.bio) {
        recs.push({ title: "Complete seu perfil", text: "Uma bio ajuda empresas a te conhecerem melhor antes de conversar." });
      } else if (!user.repos || !user.repos.length) {
        recs.push({ title: "Conecte seus repositórios", text: "Mostrar projetos reais aumenta suas chances de match." });
      } else {
        recs.push({ title: "Atualize seus repositórios", text: "Empresas visualizam perfis completos com mais frequência." });
      }

      recs.push({ title: "Explore novas vagas", text: `${jobsCount} vaga${jobsCount !== 1 ? "s" : ""} disponível${jobsCount !== 1 ? "is" : ""} esperando por você.` });

      list.innerHTML = recs.map((r, i) => `
        <li class="rec">
          <span class="rec-num" aria-hidden="true">${String(i + 1).padStart(2, "0")}</span>
          <div class="rec-body">
            <h3 class="rec-title">${escapeHtml(r.title)}</h3>
            <p class="rec-text">${escapeHtml(r.text)}</p>
          </div>
        </li>`).join("");
    }

    // ── Stats "Seu resumo" ──────────────────────────────────
    async function loadSummary(jobsCount) {
      document.getElementById("stat-jobs-meta").textContent =
        `${jobsCount} vaga${jobsCount !== 1 ? "s" : ""} disponível${jobsCount !== 1 ? "is" : ""}`;

      let unread = 0;
      try {
        const r = await fetch("/api/messages/unread-count");
        if (r.ok) unread = (await r.json()).count ?? 0;
      } catch (_) {}
      document.getElementById("stat-chats-meta").textContent =
        unread > 0 ? `${unread} nova${unread !== 1 ? "s" : ""} mensagem${unread !== 1 ? "ns" : ""}` : "Nenhuma mensagem nova";

      let roadmaps = [];
      try {
        const r = await fetch("/api/dashboard");
        if (r.ok) roadmaps = await r.json();
      } catch (_) {}

      const active = roadmaps.filter(r => r.progress_percent != null);
      if (active.length) {
        const avg = Math.round(active.reduce((s, r) => s + Number(r.progress_percent || 0), 0) / active.length);
        document.getElementById("stat-roadmap-meta").textContent = `${avg}% concluído`;
      } else {
        document.getElementById("stat-roadmap-meta").textContent = "Nenhum roadmap iniciado";
      }

      return roadmaps;
    }

    // ── Bootstrap — dados injetados pelo servidor ────────────
    (async function () {
      const user = JSON.parse(document.getElementById("boot-user").textContent);
      const jobs = JSON.parse(document.getElementById("boot-jobs").textContent);

      renderHero(user);
      renderTodayCards(jobs);
      const roadmaps = await loadSummary(jobs.length);
      renderRecs(user, jobs.length, roadmaps);

      document.getElementById("loading").hidden = true;
      document.getElementById("content").hidden = false;
    })();
  </script>

</body>
</html>
