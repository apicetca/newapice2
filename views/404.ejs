<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Ápice — Página não encontrada</title>
  <link rel="icon" type="image/webp" href="/img/principal-gradiente.webp" />
  <link rel="stylesheet" href="/css/design-system.css" />
  <style>
    body { display:flex; align-items:center; justify-content:center; min-height:100vh; margin:0; background:var(--bg); color:var(--text); font-family:var(--font-sans,sans-serif); text-align:center; }
    .error-box { max-width:420px; padding:2rem; }
    .error-code { font-size:6rem; font-weight:700; color:var(--accent,#7c3aed); margin:0; line-height:1; }
    .error-msg  { font-size:1.25rem; margin:1rem 0 .5rem; }
    .error-sub  { color:var(--muted,#6b7280); margin-bottom:2rem; }
    .btn-home   { display:inline-block; padding:.65rem 1.5rem; background:var(--accent,#7c3aed); color:#fff; border-radius:8px; text-decoration:none; font-weight:600; }
  </style>
</head>
<body>
  <div class="error-box">
    <p class="error-code">404</p>
    <p class="error-msg">Página não encontrada</p>
    <p class="error-sub">O endereço que você acessou não existe ou foi movido.</p>
    <a href="/" class="btn-home">Voltar ao início</a>
  </div>
</body>
</html>
