<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/webp" href="/img/principal-gradiente.webp" />
  <meta name="description" content="Relatório de compatibilidade de matchs — Ápice." />
  <title>Ápice — Admin · <%= categoria.titulo %></title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/design-system.css" />
  <link rel="stylesheet" href="/css/header.css" />
  <link rel="stylesheet" href="/css/admin-dashboard.css" />
  <link rel="stylesheet" href="/css/admin-vagas.css" />
  <link rel="stylesheet" href="/css/admin-relatorios.css" />
  <link rel="stylesheet" href="/css/admin-crescimento.css" />
  <link rel="stylesheet" href="/css/admin-desempenho.css" />
  <link rel="stylesheet" href="/css/admin-matchs-relatorio.css" />
</head>
<body>

  <%- include('partials/header-admin', { currentPage: 'admin-relatorios' }) %>

<main class="adm-main" id="main-content">
  <div class="adc-wrap">

    <a href="/admin/relatorios" class="adr-back">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      Voltar
    </a>

    <header class="adr-head">
      <h1 class="adr-title"><%= categoria.titulo %></h1>
      <p class="adr-sub"><%= categoria.descricao %></p>
    </header>

    <section class="adm-loading" id="loading" role="status" aria-live="polite">
      <span class="adm-spinner" aria-hidden="true"></span>
      <p>Carregando relatório...</p>
    </section>

    <div id="content" hidden>

      <%# ── Indicadores ── %>
      <section aria-labelledby="h-kpis">
        <h2 class="visually-hidden" id="h-kpis">Indicadores</h2>
        <ul class="adc-kpis">
          <li class="adc-card">
            <p class="adc-kpi-title">Total de matchs realizados</p>
            <p class="adc-kpi-row"><strong class="adc-kpi-value" id="k-total"></strong><span class="adc-badge" id="k-total-badge"></span></p>
            <span class="adc-split" aria-hidden="true"><span id="k-total-bar"></span></span>
            <p class="adc-kpi-sub" id="k-total-sub"></p>
          </li>
          <li class="adc-card">
            <p class="adc-kpi-title">Taxa geral de aceitação</p>
            <p class="adc-kpi-row"><strong class="adc-kpi-value" id="k-taxa"></strong><span class="adc-badge" id="k-taxa-badge"></span></p>
            <span class="adc-split" aria-hidden="true"><span id="k-taxa-bar"></span></span>
            <p class="adc-kpi-sub">Aceitos sobre o total de decisões das empresas</p>
          </li>
          <li class="adc-card">
            <p class="adc-kpi-title">Compatibilidade média</p>
            <p class="adc-kpi-row"><strong class="adc-kpi-value" id="k-compat"></strong><span class="adc-badge" id="k-compat-badge"></span></p>
            <p class="adc-kpi-sub">% de match atual dos pares dev x vaga</p>
          </li>
          <li class="adc-card">
            <p class="adc-kpi-title">Tempo médio para match aceito</p>
            <p class="adc-kpi-row"><strong class="adc-kpi-value" id="k-tempo"></strong><span class="adc-badge" id="k-tempo-badge"></span></p>
            <p class="adc-kpi-sub">Da candidatura do dev ao aceite da empresa</p>
          </li>
        </ul>
      </section>

      <%# ── Análise de compatibilidade ── %>
      <section class="adc-section" aria-labelledby="h-ana" aria-busy="false" id="evo">
        <div class="adc-evo-head">
          <h2 class="adc-h2" id="h-ana">Análise de compatibilidade</h2>
          <fieldset class="adv-group adc-seg" id="seg" aria-label="Período do relatório">
            <button type="button" class="adv-chip" data-p="7"      aria-pressed="false">7 dias</button>
            <button type="button" class="adv-chip" data-p="30"     aria-pressed="true">30 dias</button>
            <button type="button" class="adv-chip" data-p="90"     aria-pressed="false">90 dias</button>
            <button type="button" class="adv-chip" data-p="custom" aria-pressed="false">Personalizado</button>
          </fieldset>
        </div>

        <form class="adc-range" id="range-form" hidden novalidate>
          <div class="adv-field"><label for="r-from">De</label><input type="date" id="r-from" required /></div>
          <div class="adv-field"><label for="r-to">Até</label><input type="date" id="r-to" required /></div>
          <button type="submit" class="adv-btn adv-btn--primary">Aplicar</button>
          <p class="adv-form-error" id="range-error" role="alert"></p>
        </form>

        <figure class="adc-card adc-chart">
          <figcaption class="adc-chart-head">
            <h3 class="adc-h3">Perfil dev vs Requisitos da vaga</h3>
            <button type="button" class="adc-tbl-btn" data-target="cats" aria-pressed="false">Ver como tabela</button>
          </figcaption>
          <ul class="adc-legend" aria-label="Legenda">
            <li><span class="adc-sw" style="background:#8B5CF6"></span>Perfil dev</li>
            <li><span class="adc-sw" style="background:#0FA391"></span>Requisitos vaga</li>
          </ul>
          <div class="adc-plot" id="plot-cats" role="group" aria-label="Gráfico de barras: perfil do dev contra os requisitos da vaga por categoria, em porcentagem"></div>
          <div class="adc-table-wrap" id="table-cats" hidden></div>
          <p class="adc-note">Média das decisões do período. Para skills e roadmap o requisito é 100% (vaga atendida por completo); em senioridade, compara o nível do dev com o nível da vaga.</p>
        </figure>

        <section class="adc-card" aria-labelledby="h-nivel">
          <h3 class="adc-h3" id="h-nivel">Matchs aceitos por nível de senioridade</h3>
          <ul class="add-fill" id="nivel-list"></ul>
          <p class="adc-note">Aceitos sobre as decisões das empresas, pelo nível da vaga.</p>
        </section>
      </section>

      <%# ── Ranking de matchs ── %>
      <section class="adc-section" aria-labelledby="h-rank">
        <div class="adc-evo-head">
          <h2 class="adc-h2" id="h-rank">Ranking de matchs</h2>
          <p class="add-period" id="rank-period"></p>
        </div>
        <section class="adc-card add-rank" aria-labelledby="h-top">
          <h3 class="adc-h3" id="h-top">Top matchs recentes</h3>
          <div class="adc-table-wrap">
            <table class="adr-table add-table">
              <caption class="visually-hidden">Matchs aceitos de maior compatibilidade no período</caption>
              <thead>
                <tr>
                  <th scope="col">Dev</th>
                  <th scope="col">Empresa</th>
                  <th scope="col">Vaga</th>
                  <th scope="col" class="num">Compatibilidade</th>
                  <th scope="col" class="num">Ações</th>
                </tr>
              </thead>
              <tbody id="rank-tbody"></tbody>
            </table>
          </div>
          <p class="adm-empty" id="rank-empty" hidden>Nenhum match aceito no período.</p>
        </section>
      </section>

      <%- include('partials/admin-gerar-relatorio', { comTipo: false }) %>

    </div>
  </div>
</main>

<output class="adv-toast" id="toast" role="status" aria-live="polite"></output>

<footer class="adm-footer">
  <p>&copy; <%= new Date().getFullYear() %> Ápice. Painel do administrador.</p>
</footer>

<script src="/js/escape-html.js"></script>
<script src="/js/admin-relatorio.js"></script>
<script>
const $ = (id) => document.getElementById(id);
const API = "/api/admin/reports/compatibilidade-de-matchs";
const { COR, fmt, fmt1, hojeIso, diasAtras, qs, el, scaleFor, frame, topRound, tooltip } = AR;

const page = { p: "30", from: diasAtras(29), to: hojeIso() };
const dataBr = (iso) => `${iso.slice(8, 10)}/${iso.slice(5, 7)}/${iso.slice(0, 4)}`;
const initials = (s) => String(s || "?").trim().split(/\s+/).slice(0, 2).map(w => w.charAt(0)).join("").toUpperCase() || "?";
const safeUrl = (u) => /^https?:\/\//i.test(u || "") ? u : "";

// ── Gráfico de barras agrupadas: perfil do dev × requisitos da vaga (0–100%) ──
function renderCats(data) {
  const plot = $("plot-cats");
  plot.querySelectorAll("svg").forEach(n => n.remove());
  const W = 960, H = 290, m = { l: 48, r: 20, t: 16, b: 32 };
  const n = data.length, iw = W - m.l - m.r, gw = iw / n;
  const xAt = (i) => m.l + gw * i + gw / 2;
  const { svg, y } = frame(W, H, m, { top: 100, ticks: [0, 20, 40, 60, 80, 100] }, data.map(d => d.label), xAt);
  const base = y(0), barW = Math.max(8, Math.min(44, gw * 0.2)), gap = 6;

  data.forEach((d, i) => {
    [[d.perfil, COR.devs, xAt(i) - barW - gap / 2], [d.requisito, COR.empresas, xAt(i) + gap / 2]].forEach(([v, cor, x]) => {
      if (v != null && v > 0) svg.appendChild(el("path", { d: topRound(x, y(v), barW, base - y(v), 4), fill: cor }));
    });
  });

  const tip = tooltip(plot);
  const txt = (v) => (v == null ? 0 : v);
  data.forEach((d, i) => {
    const hit = el("rect", { x: m.l + gw * i, y: m.t, width: gw, height: H - m.t - m.b, fill: "transparent" });
    hit.addEventListener("mouseenter", () => tip.show((xAt(i) / W) * 100, `${d.label} · ${fmt(d.amostra)} pares`, [[COR.devs, "Perfil dev (%)", txt(d.perfil)], [COR.empresas, "Requisitos vaga (%)", txt(d.requisito)]]));
    hit.addEventListener("mouseleave", () => tip.hide());
    svg.appendChild(hit);
  });
  plot.prepend(svg);
}

const pc = (v) => (v == null ? "—" : `${fmt1(v)}%`);
function tableCats(rows) {
  return `<table class="adr-table"><caption class="visually-hidden">Perfil do dev e requisitos da vaga por categoria</caption>
    <thead><tr><th scope="col">Categoria</th><th scope="col" class="num">Perfil dev</th><th scope="col" class="num">Requisitos vaga</th><th scope="col" class="num">Pares</th></tr></thead>
    <tbody>${rows.map(r => `<tr><th scope="row">${escapeHtml(r.label)}</th><td class="num">${pc(r.perfil)}</td><td class="num">${pc(r.requisito)}</td><td class="num">${fmt(r.amostra)}</td></tr>`).join("")}</tbody></table>`;
}

// inverso: quando diminuir é melhor (tempo para aceitar)
function badge(node, valor, sufixo, rotulo, inverso = false) {
  node.className = "adc-badge";
  if (valor == null) { node.textContent = "—"; node.title = "Sem base de comparação no período"; return; }
  const bom = inverso ? valor < 0 : valor > 0, ruim = inverso ? valor > 0 : valor < 0;
  node.classList.add(bom ? "is-up" : ruim ? "is-down" : "is-flat");
  const num = Number.isInteger(valor) ? String(Math.abs(valor)) : fmt1(Math.abs(valor));
  node.textContent = `${valor > 0 ? "+" : valor < 0 ? "−" : ""}${num}${sufixo}`;
  node.title = rotulo;
}

function renderKpis(k) {
  $("k-total").textContent = fmt(k.total.total);
  badge($("k-total-badge"), k.total.variacao_pct, "%", "Variação do total de decisões em relação ao período anterior");
  $("k-total-bar").style.width = `${k.total.total ? (k.total.aceitos / k.total.total) * 100 : 0}%`;
  $("k-total-sub").textContent = `${fmt(k.total.aceitos)} aceitos / ${fmt(k.total.recusados)} recusados`;
  $("k-taxa").textContent = k.aceitacao.taxa == null ? "—" : `${fmt1(k.aceitacao.taxa)}%`;
  badge($("k-taxa-badge"), k.aceitacao.variacao_pp, " p.p.", "Variação da taxa de aceitação em pontos percentuais");
  $("k-taxa-bar").style.width = `${k.aceitacao.taxa ?? 0}%`;
  $("k-compat").textContent = k.compatibilidade.media == null ? "—" : `${fmt1(k.compatibilidade.media)}%`;
  badge($("k-compat-badge"), k.compatibilidade.variacao_pp, " p.p.", "Variação da compatibilidade média em pontos percentuais");
  $("k-tempo").textContent = k.tempo_aceite.dias == null ? "—" : `${fmt1(k.tempo_aceite.dias)} dias`;
  badge($("k-tempo-badge"), k.tempo_aceite.variacao_dias, k.tempo_aceite.variacao_dias === 1 || k.tempo_aceite.variacao_dias === -1 ? " dia" : " dias", "Variação do tempo médio em relação ao período anterior", true);
}

function renderNivel(rows) {
  $("nivel-list").innerHTML = rows.map(r => `
    <li class="add-fill-row">
      <span class="add-fill-label">${escapeHtml(r.label)} <span class="add-fill-pct">${r.taxa == null ? "sem decisões" : `(${r.taxa}%)`}</span></span>
      <span class="add-fill-track" aria-hidden="true"><span class="add-fill-bar" style="width:${r.taxa ?? 0}%"></span></span>
      <span class="add-fill-count">${fmt(r.aceitos)} de ${fmt(r.total)}</span>
    </li>`).join("");
}

function renderRanking(rows) {
  $("rank-empty").hidden = rows.length > 0;
  $("rank-tbody").innerHTML = rows.map(m => {
    const avatar = safeUrl(m.avatar_url)
      ? `<img class="adm-avatar" src="${escapeHtml(m.avatar_url)}" alt="" width="36" height="36" loading="lazy" />`
      : `<span class="adm-avatar" aria-hidden="true">${escapeHtml(initials(m.nome))}</span>`;
    const gh = m.github_login ? `<span class="adu-gh">@${escapeHtml(m.github_login)}</span>` : '<span class="adu-dash">-</span>';
    const ver = m.dev_user_id
      ? `<a class="adv-icon-btn" href="/admin/usuarios/${Number(m.dev_user_id)}" aria-label="Ver perfil de ${escapeHtml(m.nome)}">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></a>` : "";
    return `
    <tr>
      <th scope="row"><div class="adu-person">${avatar}<span class="adu-person-txt"><span class="adu-name">${escapeHtml(m.nome)}</span>${gh}</span></div></th>
      <td class="add-company">${escapeHtml(m.company || "—")}</td>
      <td class="add-title"><a class="add-job-link" href="/admin/vagas/${Number(m.job_id)}">${escapeHtml(m.job_title)}</a></td>
      <td class="num"><strong>${Number(m.score)}%</strong></td>
      <td class="num">${ver}</td>
    </tr>`;
  }).join("");
}

function renderAll(r) {
  renderKpis(r.kpis);
  renderCats(r.categorias);
  $("table-cats").innerHTML = tableCats(r.categorias);
  renderNivel(r.por_nivel);
  renderRanking(r.ranking);
  $("rank-period").textContent = `Período: ${dataBr(r.periodo.from)} a ${dataBr(r.periodo.to)}`;
}

async function fetchReport(sel) {
  const res = await fetch(`${API}?${qs(sel)}`);
  const data = await res.json().catch(() => ({}));
  if (!res.ok) throw new Error(data.error || "Erro ao carregar o relatório.");
  return data;
}

let toastTimer;
function toast(msg, isErr = false) {
  const t = $("toast"); t.textContent = msg; t.classList.toggle("is-error", isErr); t.classList.add("show");
  clearTimeout(toastTimer); toastTimer = setTimeout(() => t.classList.remove("show"), 2800);
}

// ── Período ──
async function aplicarPagina() {
  const evo = $("evo"); evo.setAttribute("aria-busy", "true");
  try { renderAll(await fetchReport(page)); }
  catch (err) { toast(err.message, true); }
  finally { evo.setAttribute("aria-busy", "false"); }
}
$("seg").querySelectorAll("[data-p]").forEach(btn => btn.addEventListener("click", () => {
  page.p = btn.dataset.p;
  $("seg").querySelectorAll("[data-p]").forEach(b => b.setAttribute("aria-pressed", String(b === btn)));
  $("range-form").hidden = page.p !== "custom";
  if (page.p === "custom") { $("r-from").value = page.from; $("r-to").value = page.to; $("r-from").focus(); return; }
  aplicarPagina();
}));
$("range-form").addEventListener("submit", async e => {
  e.preventDefault();
  const from = $("r-from").value, to = $("r-to").value;
  $("range-error").textContent = "";
  if (!from || !to) { $("range-error").textContent = "Informe as duas datas."; return; }
  page.from = from; page.to = to;
  try { renderAll(await fetchReport(page)); } catch (err) { $("range-error").textContent = err.message; }
});
$("r-to").max = hojeIso();

document.querySelectorAll(".adc-tbl-btn").forEach(btn => btn.addEventListener("click", () => {
  const alvo = btn.dataset.target, ativo = btn.getAttribute("aria-pressed") !== "true";
  btn.setAttribute("aria-pressed", String(ativo));
  btn.textContent = ativo ? "Ver gráfico" : "Ver como tabela";
  $(`plot-${alvo}`).hidden = ativo; $(`table-${alvo}`).hidden = !ativo;
}));

// ── Gerar relatório (pop-up) ──
AR.initGerar({ api: API, comTipo: false, toast });

(async function init() {
  try {
    const r = await fetchReport(page);
    $("loading").hidden = true; $("content").hidden = false;
    renderAll(r);
  } catch (err) {
    console.error(err);
    $("loading").innerHTML = `
      <div role="alert">
        <p class="adm-error">Erro ao carregar o relatório.</p>
        <a class="adm-error-link" href="/admin/relatorios">← Voltar às categorias</a>
      </div>`;
  }
})();
</script>

</body>
</html>
