<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/webp" href="/img/principal-gradiente.webp" />
  <meta name="description" content="Relatório de uso da plataforma — Ápice." />
  <title>Ápice — Admin · <%= categoria.titulo %></title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/design-system.css" />
  <link rel="stylesheet" href="/css/header.css" />
  <link rel="stylesheet" href="/css/admin-dashboard.css" />
  <link rel="stylesheet" href="/css/admin-vagas.css" />
  <link rel="stylesheet" href="/css/admin-relatorios.css" />
  <link rel="stylesheet" href="/css/admin-crescimento.css" />
  <link rel="stylesheet" href="/css/admin-desempenho.css" />
</head>
<body>

  <%- include('partials/header-admin', { currentPage: 'admin-relatorios' }) %>

<main class="adm-main" id="main-content">
  <div class="adc-wrap">

    <a href="/admin/relatorios" class="adr-back">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      Voltar
    </a>

    <header class="adr-head">
      <h1 class="adr-title"><%= categoria.titulo %></h1>
      <p class="adr-sub"><%= categoria.descricao %></p>
    </header>

    <section class="adm-loading" id="loading" role="status" aria-live="polite">
      <span class="adm-spinner" aria-hidden="true"></span>
      <p>Carregando relatório...</p>
    </section>

    <div id="content" hidden>

      <p class="adc-notice" id="coleta-aviso" role="status" hidden></p>

      <%# ── Indicadores ── %>
      <section aria-labelledby="h-kpis">
        <h2 class="visually-hidden" id="h-kpis">Indicadores</h2>
        <ul class="adc-kpis">
          <li class="adc-card">
            <p class="adc-kpi-title">Sessões ativas diárias</p>
            <p class="adc-kpi-row"><strong class="adc-kpi-value" id="k-sess"></strong><span class="adc-badge" id="k-sess-badge"></span></p>
            <p class="adc-kpi-sub" id="k-sess-sub"></p>
          </li>
          <li class="adc-card">
            <p class="adc-kpi-title">Tempo médio por sessão</p>
            <p class="adc-kpi-row"><strong class="adc-kpi-value" id="k-tempo"></strong><span class="adc-badge" id="k-tempo-badge"></span></p>
            <p class="adc-kpi-sub">Da primeira à última atividade da sessão</p>
          </li>
          <li class="adc-card">
            <p class="adc-kpi-title">Utilização do Mentor</p>
            <p class="adc-kpi-row"><strong class="adc-kpi-value" id="k-mentor"></strong><span class="adc-badge" id="k-mentor-badge"></span></p>
            <span class="adc-split" aria-hidden="true"><span id="k-mentor-bar"></span></span>
            <p class="adc-kpi-sub" id="k-mentor-sub"></p>
          </li>
          <li class="adc-card">
            <p class="adc-kpi-title">Taxa de retenção de 30 dias</p>
            <p class="adc-kpi-row"><strong class="adc-kpi-value" id="k-ret"></strong><span class="adc-badge" id="k-ret-badge"></span></p>
            <span class="adc-split" aria-hidden="true"><span id="k-ret-bar"></span></span>
            <p class="adc-kpi-sub" id="k-ret-sub"></p>
          </li>
        </ul>
      </section>

      <%# ── Dinâmica e engajamento ── %>
      <section class="adc-section" aria-labelledby="h-din" aria-busy="false" id="evo">
        <div class="adc-evo-head">
          <h2 class="adc-h2" id="h-din">Dinâmica e engajamento</h2>
          <fieldset class="adv-group adc-seg" id="seg" aria-label="Período do relatório">
            <button type="button" class="adv-chip" data-p="7"      aria-pressed="false">7 dias</button>
            <button type="button" class="adv-chip" data-p="30"     aria-pressed="true">30 dias</button>
            <button type="button" class="adv-chip" data-p="90"     aria-pressed="false">90 dias</button>
            <button type="button" class="adv-chip" data-p="custom" aria-pressed="false">Personalizado</button>
          </fieldset>
        </div>

        <form class="adc-range" id="range-form" hidden novalidate>
          <div class="adv-field"><label for="r-from">De</label><input type="date" id="r-from" required /></div>
          <div class="adv-field"><label for="r-to">Até</label><input type="date" id="r-to" required /></div>
          <button type="submit" class="adv-btn adv-btn--primary">Aplicar</button>
          <p class="adv-form-error" id="range-error" role="alert"></p>
        </form>

        <figure class="adc-card adc-chart">
          <figcaption class="adc-chart-head">
            <h3 class="adc-h3">Picos de acesso por horários</h3>
            <button type="button" class="adc-tbl-btn" data-target="hor" aria-pressed="false">Ver como tabela</button>
          </figcaption>
          <ul class="adc-legend" aria-label="Legenda">
            <li><span class="adc-sw" style="background:#8B5CF6"></span>Devs</li>
            <li><span class="adc-sw" style="background:#0FA391"></span>Empresas</li>
          </ul>
          <div class="adc-plot" id="plot-hor" role="group" aria-label="Gráfico de barras: sessões iniciadas por faixa de duas horas, devs e empresas"></div>
          <div class="adc-table-wrap" id="table-hor" hidden></div>
          <p class="adc-note">Sessões iniciadas em cada faixa de 2 horas, no horário de São Paulo.</p>
        </figure>

        <section class="adc-card" aria-labelledby="h-mod">
          <h3 class="adc-h3" id="h-mod">Módulos mais acessados</h3>
          <ul class="add-fill" id="mod-list"></ul>
          <p class="adc-note">Parcela dos usuários ativos no período que usou cada módulo.</p>
        </section>
      </section>

      <%- include('partials/admin-gerar-relatorio', { comTipo: false }) %>

    </div>
  </div>
</main>

<output class="adv-toast" id="toast" role="status" aria-live="polite"></output>

<footer class="adm-footer">
  <p>&copy; <%= new Date().getFullYear() %> Ápice. Painel do administrador.</p>
</footer>

<script src="/js/escape-html.js"></script>
<script src="/js/admin-relatorio.js"></script>
<script>
const $ = (id) => document.getElementById(id);
const API = "/api/admin/reports/uso-da-plataforma";
const { COR, fmt, fmt1, hojeIso, diasAtras, qs, el, scaleFor, frame, topRound, tooltip } = AR;

const page = { p: "30", from: diasAtras(29), to: hojeIso() };
const dataBr = (iso) => `${iso.slice(8, 10)}/${iso.slice(5, 7)}/${iso.slice(0, 4)}`;
const duracao = (s) => (s == null ? "—" : `${Math.floor(s / 60)}min${String(s % 60).padStart(2, "0")}s`);

// ── Gráfico de barras agrupadas: sessões por faixa de horário ──
function renderHorarios(data) {
  const plot = $("plot-hor");
  plot.querySelectorAll("svg").forEach(n => n.remove());
  const W = 960, H = 290, m = { l: 48, r: 20, t: 16, b: 32 };
  const n = data.length, iw = W - m.l - m.r, gw = iw / n;
  const xAt = (i) => m.l + gw * i + gw / 2;
  const maxV = Math.max(...data.map(d => Math.max(d.devs, d.empresas)), 0);
  const { svg, y } = frame(W, H, m, scaleFor(maxV), data.map(d => d.label), xAt);
  const base = y(0), barW = Math.max(6, Math.min(26, gw * 0.3)), gap = 4;

  data.forEach((d, i) => {
    [[d.devs, COR.devs, xAt(i) - barW - gap / 2], [d.empresas, COR.empresas, xAt(i) + gap / 2]].forEach(([v, cor, x]) => {
      if (v > 0) svg.appendChild(el("path", { d: topRound(x, y(v), barW, base - y(v), 4), fill: cor }));
    });
  });

  const tip = tooltip(plot);
  data.forEach((d, i) => {
    const hit = el("rect", { x: m.l + gw * i, y: m.t, width: gw, height: H - m.t - m.b, fill: "transparent" });
    hit.addEventListener("mouseenter", () => tip.show((xAt(i) / W) * 100, `${d.label} às ${(parseInt(d.label, 10) + 2) % 24}h`, [[COR.devs, "Devs", d.devs], [COR.empresas, "Empresas", d.empresas]]));
    hit.addEventListener("mouseleave", () => tip.hide());
    svg.appendChild(hit);
  });
  plot.prepend(svg);
}

function tableHorarios(rows) {
  return `<table class="adr-table"><caption class="visually-hidden">Sessões iniciadas por faixa de horário</caption>
    <thead><tr><th scope="col">Faixa</th><th scope="col" class="num">Devs</th><th scope="col" class="num">Empresas</th></tr></thead>
    <tbody>${rows.map(r => `<tr><th scope="row">${escapeHtml(r.label)}</th><td class="num">${fmt(r.devs)}</td><td class="num">${fmt(r.empresas)}</td></tr>`).join("")}</tbody></table>`;
}

function badge(node, valor, sufixo, rotulo) {
  node.className = "adc-badge";
  if (valor == null) { node.textContent = "—"; node.title = "Sem base de comparação no período"; return; }
  node.classList.add(valor > 0 ? "is-up" : valor < 0 ? "is-down" : "is-flat");
  const num = Number.isInteger(valor) ? String(Math.abs(valor)) : fmt1(Math.abs(valor));
  node.textContent = `${valor > 0 ? "+" : valor < 0 ? "−" : ""}${num}${sufixo}`;
  node.title = rotulo;
}

function renderKpis(k) {
  $("k-sess").textContent = fmt(Math.round(k.sessoes_diarias.media));
  badge($("k-sess-badge"), k.sessoes_diarias.variacao_pct, "%", "Variação das sessões diárias em relação ao período anterior");
  $("k-sess-sub").textContent = `Média de ${fmt1(k.sessoes_diarias.usuarios_dia)} usuários únicos por dia`;
  $("k-tempo").textContent = duracao(k.tempo_sessao.segundos);
  badge($("k-tempo-badge"), k.tempo_sessao.variacao_pct, "%", "Variação do tempo médio em relação ao período anterior");
  $("k-mentor").textContent = k.mentor.taxa == null ? "—" : `${fmt1(k.mentor.taxa)}%`;
  badge($("k-mentor-badge"), k.mentor.variacao_pp, " p.p.", "Variação da utilização do Mentor em pontos percentuais");
  $("k-mentor-bar").style.width = `${k.mentor.taxa ?? 0}%`;
  $("k-mentor-sub").textContent = `${fmt(k.mentor.usuarios)} de ${fmt(k.mentor.devs_ativos)} devs ativos`;
  $("k-ret").textContent = k.retencao.taxa == null ? "—" : `${fmt1(k.retencao.taxa)}%`;
  badge($("k-ret-badge"), k.retencao.variacao_pp, " p.p.", "Variação da retenção em pontos percentuais");
  $("k-ret-bar").style.width = `${k.retencao.taxa ?? 0}%`;
  $("k-ret-sub").textContent = k.retencao.coorte
    ? `${fmt(k.retencao.retidos)} de ${fmt(k.retencao.coorte)} contas voltaram após 30 dias`
    : "Ainda sem contas com 30 dias de coleta";
}

function renderModulos(rows) {
  $("mod-list").innerHTML = rows.map(r => `
    <li class="add-fill-row">
      <span class="add-fill-label">${escapeHtml(r.label)} <span class="add-fill-pct">${r.taxa == null ? "sem dados" : `(${r.taxa}%)`}</span></span>
      <span class="add-fill-track" aria-hidden="true"><span class="add-fill-bar" style="width:${r.taxa ?? 0}%"></span></span>
      <span class="add-fill-count">${fmt(r.usuarios)} usuários</span>
    </li>`).join("");
}

function renderAviso(c) {
  const a = $("coleta-aviso");
  a.hidden = !c.parcial;
  a.textContent = c.desde
    ? `A coleta de uso começou em ${dataBr(c.desde)}. Períodos que começam antes dessa data aparecem incompletos.`
    : "A coleta de uso ainda não registrou nenhum acesso; os números de sessão, horários e módulos aparecerão conforme os usuários navegarem.";
}

function renderAll(r) {
  renderAviso(r.coleta);
  renderKpis(r.kpis);
  renderHorarios(r.horarios);
  $("table-hor").innerHTML = tableHorarios(r.horarios);
  renderModulos(r.modulos);
}

async function fetchReport(sel) {
  const res = await fetch(`${API}?${qs(sel)}`);
  const data = await res.json().catch(() => ({}));
  if (!res.ok) throw new Error(data.error || "Erro ao carregar o relatório.");
  return data;
}

let toastTimer;
function toast(msg, isErr = false) {
  const t = $("toast"); t.textContent = msg; t.classList.toggle("is-error", isErr); t.classList.add("show");
  clearTimeout(toastTimer); toastTimer = setTimeout(() => t.classList.remove("show"), 2800);
}

// ── Período ──
async function aplicarPagina() {
  const evo = $("evo"); evo.setAttribute("aria-busy", "true");
  try { renderAll(await fetchReport(page)); }
  catch (err) { toast(err.message, true); }
  finally { evo.setAttribute("aria-busy", "false"); }
}
$("seg").querySelectorAll("[data-p]").forEach(btn => btn.addEventListener("click", () => {
  page.p = btn.dataset.p;
  $("seg").querySelectorAll("[data-p]").forEach(b => b.setAttribute("aria-pressed", String(b === btn)));
  $("range-form").hidden = page.p !== "custom";
  if (page.p === "custom") { $("r-from").value = page.from; $("r-to").value = page.to; $("r-from").focus(); return; }
  aplicarPagina();
}));
$("range-form").addEventListener("submit", async e => {
  e.preventDefault();
  const from = $("r-from").value, to = $("r-to").value;
  $("range-error").textContent = "";
  if (!from || !to) { $("range-error").textContent = "Informe as duas datas."; return; }
  page.from = from; page.to = to;
  try { renderAll(await fetchReport(page)); } catch (err) { $("range-error").textContent = err.message; }
});
$("r-to").max = hojeIso();

document.querySelectorAll(".adc-tbl-btn").forEach(btn => btn.addEventListener("click", () => {
  const alvo = btn.dataset.target, ativo = btn.getAttribute("aria-pressed") !== "true";
  btn.setAttribute("aria-pressed", String(ativo));
  btn.textContent = ativo ? "Ver gráfico" : "Ver como tabela";
  $(`plot-${alvo}`).hidden = ativo; $(`table-${alvo}`).hidden = !ativo;
}));

// ── Gerar relatório (pop-up) ──
AR.initGerar({ api: API, comTipo: false, toast });

(async function init() {
  try {
    const r = await fetchReport(page);
    $("loading").hidden = true; $("content").hidden = false;
    renderAll(r);
  } catch (err) {
    console.error(err);
    $("loading").innerHTML = `
      <div role="alert">
        <p class="adm-error">Erro ao carregar o relatório.</p>
        <a class="adm-error-link" href="/admin/relatorios">← Voltar às categorias</a>
      </div>`;
  }
})();
</script>

</body>
</html>
