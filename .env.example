# ── Servidor ──────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# URL pública/base desta instância, sem barra final. Obrigatória — o app
# não sobe sem ela. Usada para:
#   - montar a redirect_uri do login GitHub OAuth (APP_URL + /auth/github/callback);
#   - montar links enviados por e-mail (ex: redefinição de senha), em vez de
#     confiar no header Host da requisição (que um proxy mal configurado
#     pode repassar sem validar).
#   Dev:        http://localhost:3000
#   Produção:   https://newapice22.onrender.com
APP_URL=http://localhost:3000

# ── Banco de dados (Clever Cloud MySQL, ou qualquer MySQL 8) ──
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# ── GitHub OAuth App ───────────────────────────────────────
# Criar em: https://github.com/settings/developers
#
# IMPORTANTE: use um OAuth App DIFERENTE para cada ambiente, cada um com
# sua própria "Authorization callback URL" cadastrada no GitHub:
#   - OAuth App de DEV:  callback = http://localhost:3000/auth/github/callback
#   - OAuth App de PROD: callback = https://newapice22.onrender.com/auth/github/callback
# Um único OAuth App compartilhado entre dev e produção faz o GitHub usar
# sempre a mesma callback cadastrada, independente do redirect_uri enviado,
# e mistura sessões/credenciais dos dois ambientes.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Sessão ─────────────────────────────────────────────────
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── E-mail transacional (recuperação de senha) ─────────────
# Sem essas variáveis, "Esqueci minha senha" continua respondendo
# com sucesso genérico (não vaza quais e-mails existem), mas o
# e-mail de fato não é enviado — só um log de erro no servidor.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Ápice <no-reply@apice.app>

# ── Bootstrap da conta administradora ───────────────────────
# Não existe cadastro público de admin. Rode `node database/seed-admin.js`
# uma vez com essas variáveis definidas para criar a primeira conta.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOME=Administrador

# ── Gemini (Google AI Studio, nível gratuito) — funcionalidades de IA ──
# Criar chave em: https://aistudio.google.com/apikey
# Sem GEMINI_API_KEY definida, as funcionalidades de IA falham de
# forma isolada (erro logado no servidor) — o resto da plataforma
# continua funcionando normalmente.
#
# Client: SDK oficial @google/genai (services/geminiClient.js), usando
# a Interactions API (ai.interactions.create) — não ai.models.generateContent.
# gemini-3.7-flash e gemini-3.8-flash foram testados em 2026-09-15 e
# retornaram 503 "high demand" de forma consistente; gemini-3.6-flash
# segue sendo o modelo estável.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ── Fallback multi-provedor (services/aiFallback.js) ─────────
# Se o Gemini falhar (cota esgotada, 5xx, timeout), askGeminiJSON()
# tenta esses provedores gratuitos em ordem, via SDK da OpenAI
# (todos falam o formato OpenAI-compatible). Provedor sem chave
# configurada é pulado automaticamente — nenhuma é obrigatória,
# mas sem nenhuma o app fica sem fallback se o Gemini cair.
# NÃO cobre o mentor de carreira (memória de conversa + function
# calling são exclusivos do Gemini).
#
# Groq — criar chave em: https://console.groq.com/keys
GROQ_API_KEY=
# Cerebras — criar chave em: https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# Mistral (La Plateforme) — criar chave em: https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# OpenRouter — criar chave em: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── Troca de plano sem checkout (dev/teste) ─────────────────
# Com true, qualquer usuário dev logado pode trocar o próprio plano
# (Gratuito ⇄ PRO) direto em /perfil#plano, sem pagamento — usado pra
# testar funcionalidades PRO (mentor de carreira, simulador de
# entrevista) sem depender do admin. NUNCA deixar true em produção:
# omitir esta variável (ou defini-la como false) desativa a troca.
ALLOW_SELF_PLAN_SWITCH=false
